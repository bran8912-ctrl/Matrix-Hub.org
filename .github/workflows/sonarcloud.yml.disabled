# This workflow has been replaced by code-quality.yml
# 
# The new workflow provides similar functionality without requiring SonarCloud:
# - TypeScript type checking with @astrojs/check
# - ESLint for JavaScript/TypeScript code quality
# - Solhint for Solidity contract linting
# - Smart contract compilation
#
# To re-enable SonarCloud, remove this header and rename the file back to sonarcloud.yml,
# then configure the SONAR_TOKEN secret and update the project key and organization.
#
# This workflow uses actions that are not certified by GitHub.
# They are provided by a third-party and are governed by
# separate terms of service, privacy policy, and support
# documentation.

# SonarCloud analysis workflow for Matrix-Hub.org
# Scans TypeScript, JavaScript, and Solidity code for code quality and security issues
# Matches project structure: /src, /contracts, /scripts
# Excludes: .astro files, /public, /dist, /supabase, /node_modules, /docs

name: SonarCloud analysis

on:
  push:
    branches: [ "Hub10" ]
  pull_request:
    branches: [ "Hub10" ]
  workflow_dispatch:

permissions:
  pull-requests: read # allows SonarCloud to decorate PRs with analysis results

jobs:
  Analysis:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Shallow clones should be disabled for better analysis relevancy

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Compile smart contracts
        run: npm run compile

      - name: Analyze with SonarCloud
        uses: SonarSource/sonarcloud-github-action@4006f663ecaf1f8093e8e4abb9227f6041f52216
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}  # Needed to get PR information, if any
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}   # Generate a token on Sonarcloud.io, add it to the secrets of this repo with the name SONAR_TOKEN (Settings > Secrets > Actions > add new repository secret)
        with:
          # Additional arguments for the SonarScanner CLI
          # TODO: Replace the placeholders below with your actual SonarCloud project key and organization
          args: >
            -Dsonar.projectKey=YOUR_SONARCLOUD_PROJECT_KEY
            -Dsonar.organization=YOUR_SONARCLOUD_ORGANIZATION
            -Dsonar.sources=src,contracts,scripts
            -Dsonar.exclusions=**/*.astro,public/**,dist/**,supabase/**,node_modules/**,docs/**,cache/**,artifacts/**,typechain-types/**,.astro/**
            -Dsonar.javascript.node.maxspace=4096
            -Dsonar.typescript.node.maxspace=4096
          projectBaseDir: .
