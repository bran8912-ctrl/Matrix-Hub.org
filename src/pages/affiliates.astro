      <div class="header-badge">PARTNER NETWORK</div>
      <h1 class="page-title">AFFILIATE HUB</h1>
      <p class="page-subtitle">
        Curated partner deals — crypto, finance, AI tools, shopping, gaming &amp; more.<br />
        Every link supports the Matrix Hub ecosystem. 100% free to use.
      </p>
      <div class="header-stats">
        <span class="stat">{DEALS.length} <small>deals</small></span>
        <span class="stat-divider">·</span>
        <span class="stat">{CATEGORIES.length - 1} <small>categories</small></span>
        <span class="stat-divider">·</span>
        <span class="stat">0 <small>cost to you</small></span>
      </div>
    </div>

    <!-- ── Disclaimer Banner ── -->
    <div class="disclaimer-banner">
      <span class="disclaimer-icon">ℹ️</span>
      <span>
        Affiliate links — we may earn a commission at no extra cost to you.
        All partners are personally vetted. Your support keeps Matrix Hub free.
      </span>
    </div>

    <!-- ── Category Filter Tabs ── -->
    <nav class="filter-nav" id="filter-nav" aria-label="Deal categories">
      {CATEGORIES.map((cat) => (
        <button
          class={`filter-btn ${cat.key === "all" ? "active" : ""}`}
          data-category={cat.key}
          type="button"
        >
          {cat.label}
          <span class="filter-count">{cat.count}</span>
        </button>
      ))}
    </nav>

    <!-- ── Deals Grid ── -->
    <div class="deals-grid" id="deals-grid">
      {DEALS.map((deal) => (
        <article class="deal-card" data-category={deal.category}>
          <!-- Badge row -->
          <div class="deal-top">
            <span class="deal-category-tag">{deal.label}</span>
            <span class="deal-badge" style={`background: ${deal.badgeColor}20; color: ${deal.badgeColor}; border-color: ${deal.badgeColor}50;`}>
              {deal.badge}
            </span>
          </div>

          <!-- Title & emoji -->
          <div class="deal-title-row">
            <span class="deal-emoji" aria-hidden="true">{deal.emoji}</span>
            <h2 class="deal-title">{deal.title}</h2>
          </div>

          <!-- Description -->
          <p class="deal-description">{deal.description}</p>

          <!-- Bonus highlight -->
          <div class="deal-bonus">
            <span class="bonus-icon">✦</span>
            {deal.bonus}
          </div>

          <!-- CTA -->
          <a
            href={deal.url}
            target="_blank"
            rel="noopener noreferrer"
            class="deal-cta"
            data-deal={deal.title}
            data-category={deal.category}
            aria-label={`Open ${deal.title}`}
          >
            GET THIS DEAL
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <!-- ── No results fallback (hidden by default) ── -->
    <div class="no-results" id="no-results" style="display:none;">
      <span>🔍</span>
      <p>No deals in this category yet.</p>
    </div>

    <!-- ── Support Banner ── -->
    <div class="support-banner panel">
      <h2 class="support-title">⚡ Support Matrix Hub Directly</h2>
      <p class="support-desc">
        Using affiliate links supports us for free — but if you want to tip directly, every contribution keeps the platform running and free for everyone.
      </p>
      <div class="support-methods">
        <a href="https://www.paypal.me/bletourneau692" target="_blank" rel="noopener noreferrer" class="support-btn paypal">
          💳 PayPal
        </a>
        <a href="https://venmo.com/code?user_id=2943286704603136860&created=1765731516" target="_blank" rel="noopener noreferrer" class="support-btn venmo">
          📱 Venmo
        </a>
        <a href="https://cash.app/$bran8912" target="_blank" rel="noopener noreferrer" class="support-btn cashapp">
          💵 Cash App
        </a>
        <a href="https://t.me/matrixhuborg" target="_blank" rel="noopener noreferrer" class="support-btn telegram">
          📢 Telegram
        </a>
      </div>
    </div>

  </div>
</Layout>

<!-- ── Category filter script ───────────────────────────────────────────────── -->
<script is:inline>
  (function () {
    const grid      = document.getElementById('deals-grid');
    const noResults = document.getElementById('no-results');
    const filterNav = document.getElementById('filter-nav');

    if (!grid || !noResults || !filterNav) return;

    filterNav.addEventListener('click', (e) => {
      const btn = e.target.closest('.filter-btn');
      if (!btn) return;

      const cat = btn.dataset.category;

      // Update active tab
      filterNav.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Filter cards
      let visible = 0;
      grid.querySelectorAll('.deal-card').forEach((card) => {
        const matches = cat === 'all' || card.dataset.category === cat;
        card.style.display = matches ? '' : 'none';
        if (matches) visible++;
      });

      noResults.style.display = visible === 0 ? 'block' : 'none';
    });
  })();
</script>

<style>
  /* ── Page layout ──────────────────────────────────────────────────────── */
