<script>
  // Analytics: affiliate_click with deal + category (no PII, no destination data).
  document.querySelectorAll('a.deal-cta').forEach(function (el) {
    el.addEventListener('click', function () {
      try {
        (window as any).trackMatrixEvent?.('affiliate_click', {
          deal: el.getAttribute('data-deal') || '',
          category: el.getAttribute('data-category') || '',
        });
      } catch (e) {}
    });
  });
</script>
