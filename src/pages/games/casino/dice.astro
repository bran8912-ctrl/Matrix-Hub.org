---
import Layout from "../../../components/Layout.astro";
import CasinoGameWrapper from "../../../components/CasinoGameWrapper";
import DiceGame from "../../../casino/dice/DiceGame";

export const prerender = true;

export const title = "Dice";
export const navCategory = "casino";
---

<Layout title="Dice - Matrix-Hub Casino">
  <div class="container mx-auto px-4 py-8">
    <CasinoGameWrapper client:only="react" game="dice">
      {(props: any) => <DiceGame {...props} />}
    </CasinoGameWrapper>
  </div>
</Layout>
