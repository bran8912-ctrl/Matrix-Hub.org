---
import Layout from "../../../components/Layout.astro";
import ReferralGamePanel from "../../../components/ReferralGamePanel.astro";
import CasinoGameWrapper from "../../../components/CasinoGameWrapper";
import SlotsGame from "../../../casino/slots/SlotsGame";

export const prerender = true;

export const title = "Slots";
export const navCategory = "casino";
---

<Layout title="Slots - Matrix-Hub Casino">
  <div class="container mx-auto px-4 py-8">
    <CasinoGameWrapper client:only="react">
      {(props: any) => <SlotsGame {...props} />}
    </CasinoGameWrapper>
  </div>

  <!-- Referral Program Phase 1: credit-on-play panel + perk theme picker -->
  <ReferralGamePanel />
</Layout>
