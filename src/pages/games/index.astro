---
import Layout from "../../components/Layout.astro";
import GameCard from "../../components/GameCard.astro";
import ReferralThemePicker from "../../components/ReferralThemePicker.astro";
import LiveChat from "../../components/LiveChat.tsx";
import { games } from "../../data/games";

export const prerender = true;
export const title = "Free Games";
export const navCategory = "games";
---

<Layout title="Free Games | Matrix Hub">
  <!-- Hero Section -->
  <div class="games-hero">
    <h1 class="hero-title">🎮 Matrix Games Arcade</h1>
    <p class="hero-subtitle">
      Free, open-source browser games — play instantly, no install required.
      All games sourced from the open-source community.
    </p>
    <p class="hero-count">{games.length} titles available</p>
    <p class="hero-invite">
      Invite friends, unlock perks — <a href="/wallet#invite">get your invite link</a>
    </p>
  </div>

  <!-- Daily challenge + streak (Competitive Phase 1, HUB 155).
       Filled client-side by the shared matrix-best module; stays hidden
       when storage or the module is unavailable. All data is local to
       this device — there is no global board. -->
  <div class="challenge-card" id="mh-hub-challenge-wrap" hidden>
    <div id="mh-hub-challenge" class="mh-hub-challenge"></div>
    <div id="mh-hub-streak" class="mh-hub-streak"></div>
    <a id="mh-hub-challenge-play" class="challenge-play-btn" href="/games">▶ Play today's challenge</a>
    <p class="mh-local-note">Your scores, boards and streaks live on this device only.</p>
  </div>

  <!-- Referral Program Phase 1: perk theme picker ("Neon Grid") -->
  <ReferralThemePicker />

  <!-- Live Chat: games room -->
  <div class="live-chat-section">
    <LiveChat
      client:only="react"
      roomId="games"
      roomLabel="🎮 Arcade Live Chat"
      allowedTopics={[
        "game", "games", "arcade", "play", "score", "level", "highscore",
        "high score", "snake", "breakout", "tetris", "puzzle", "platformer",
        "retro", "browser game", "free game", "indie", "pixel", "speedrun",
        "challenge", "multiplayer", "tips", "strategy", "cheats", "secrets",
        "easter egg", "achievement", "leaderboard", "controls", "gameplay",
      ]}
      botName="🕹️ ArcadeBot"
      botTips={[
        // ── Snake strategies ─────────────────────────────────────────────
        "🐍 Snake Strategy: Coil your snake in a spiral pattern, keeping the inside of the spiral free — this prevents you from trapping yourself as you grow.",
        "🐍 Snake Strategy: Slow down near the edges! Corners are the most dangerous spots — give yourself room to turn.",
        "🐍 Snake Strategy: Follow the walls early in the game. Hugging the perimeter keeps the center open as an emergency escape route when the snake gets long.",
        "🐍 Snake Strategy: Never turn directly back on yourself — plan your next two moves ahead, not just one. Reactive play kills long snakes.",
        "🐍 Snake Strategy: The food is a trap as much as a reward. Before going for it, check whether the path home is clear after eating.",
        "🐍 Snake Expert: Advanced players use the 'Hamiltonian cycle' method — mentally plan a path that visits every cell exactly once. This theoretically guarantees you can never trap yourself.",

        // ── Breakout strategies ──────────────────────────────────────────
        "🧱 Breakout Strategy: Aim for the top rows first — bricks higher up are worth more points and clearing them lets the ball bounce wildly for chain breaks.",
        "🧱 Breakout Strategy: Once you punch a hole to the ceiling, let the ball bounce up there and take out rows on its own for huge point runs.",
        "🧱 Breakout Strategy: Control your paddle angle deliberately. Hitting the ball with the edge sends it at a sharp angle — useful for targeting the side columns.",
        "🧱 Breakout Strategy: Don't always rush to return the ball immediately. Letting it drift to the bottom of the screen gives you a moment to reposition your paddle precisely.",
        "🧱 Breakout Expert: The last few bricks are the hardest. Use a gentle touch to angle the ball exactly where you need it — speed is your enemy at that point.",

        // ── General arcade tips ──────────────────────────────────────────
        "🎮 General Tip: Most arcade games here support keyboard controls — arrow keys to move, spacebar to shoot or jump. Check the in-game help screen first!",
        "🎮 General Tip: Set a personal high score target before each session to make it more challenging and rewarding.",
        "🎮 General Tip: Warm up with 2–3 short runs before going for a high-score attempt. Muscle memory needs to activate before peak performance kicks in.",
        "🎮 General Tip: Take short breaks between sessions. Fatigue degrades reaction time more than most people realise — 5 minutes off the screen resets your focus.",
        "🎮 General Tip: Play in full-screen mode when available. Eliminating peripheral distractions measurably improves reaction time in fast-paced arcade games.",

        // ── Retro / pattern recognition ──────────────────────────────────
        "🕹️ Retro Strategy: Patterns are everything in classic arcade games. Enemies and obstacles often follow predictable paths — observe before acting.",
        "🕹️ Retro Strategy: Save your power-ups! It's tempting to use abilities immediately, but saving them for tough sections pays off.",
        "🕹️ Retro Expert: Most classic arcade games have a 'kill screen' or max score limit. Study the pattern of early levels first — the same rhythm repeats at higher difficulties.",
        "🕹️ Retro Expert: In shooting games, 'safe spots' almost always exist — positions where enemies can't hit you but you can hit them. Test every corner of the screen early on.",

        // ── Speedrunning ─────────────────────────────────────────────────
        "🏆 Speedrun Strategy: To improve your time, focus on movement efficiency first — shaving wasted movement often beats memorising shortcuts.",
        "🏆 Speedrun Strategy: Record your runs and review them. Watching your own gameplay is the fastest way to spot inefficiencies.",
        "🏆 Speedrun Expert: Set a 'reset threshold' — if you fall more than X seconds behind your pace by a certain checkpoint, reset immediately rather than grinding out a suboptimal run.",
        "🏆 Speedrun Expert: Route optimisation beats mechanical skill improvement at the start. Knowing a slightly shorter path is more reliable than executing a risky trick perfectly.",

        // ── Puzzle tips ──────────────────────────────────────────────────
        "💡 Puzzle Strategy: If you're stuck, step back and look at the big picture. Sometimes the solution requires setting up multiple moves ahead.",
        "💡 Puzzle Expert: Most browser puzzles have a finite set of mechanics. List every mechanic available to you and systematically test combinations — lateral thinking beats brute force.",
        "💡 Code Breaker Tip: Start by placing unique symbols in each position to maximise information from the first guess. The more you can eliminate at once, the faster you converge on the answer.",

        // ── Platformer tips ──────────────────────────────────────────────
        "💡 Platformer Strategy: Learn the jump arc of your character — knowing the exact peak of your jump lets you make precise landings on tight platforms.",
        "💡 Platformer Expert: Many platformers have 'coyote time' — a brief window after walking off a ledge where you can still jump. Test it in each game; it can save you from frustrating falls.",
        "💡 Platformer Expert: Wall-jump techniques often chain into faster movement. Even if a game doesn't explicitly teach it, test whether holding toward a wall while jumping produces extra height or speed.",

        // ── Instruments / music tools ─────────────────────────────────────
        "🎵 Instrument Strategy: Browser instruments work best with a low-latency audio device. Headphones reduce echo and help you stay in rhythm.",
        "🎵 Instrument Expert: Use the keyboard's home row keys as your 'anchor' — this is how professional virtual keyboard players build speed. ASDF and JKL; map naturally to musical scales in most browser instruments.",
        "🎵 Instrument Expert: Record short loops and listen back immediately. Your brain corrects timing errors in real-time playback that you can't hear while playing.",

        // ── Playground / experimental ─────────────────────────────────────
        "🌱 Playground Tip: Playgrounds are great for experimenting — try combining features in unexpected ways to discover hidden interactions!",
        "🌱 Playground Expert: Treat every playground session as a research sprint. Set a single hypothesis ('what happens if I do X?') and test it — this structured exploration produces far more discoveries than open-ended clicking.",
      ]}
    />
  </div>

  <!-- Controls: filters + search -->
  <div class="controls">
    <!-- Category filter tabs -->
    <div class="filter-tabs" role="group" aria-label="Filter by category">
      <button class="filter-btn active" data-filter="all" aria-pressed="true">All</button>
      <button class="filter-btn" data-filter="game" aria-pressed="false">🕹️ Games</button>
      <button class="filter-btn" data-filter="playground" aria-pressed="false">🌱 Playgrounds</button>
      <button class="filter-btn" data-filter="instrument" aria-pressed="false">🎵 Instruments</button>
    </div>

    <div class="search-row">
      <!-- Search bar -->
      <input
        type="search"
        id="game-search"
        placeholder="Search games…"
        class="search-input"
        aria-label="Search games by name"
      />

      <!-- Mobile-only toggle -->
      <label class="mobile-toggle" for="mobile-only">
        <input type="checkbox" id="mobile-only" />
        <span>📱 Mobile only</span>
      </label>
    </div>
  </div>

  <!-- No results message -->
  <p id="no-results" class="no-results" hidden>No games match your filters.</p>

  <!-- Games grid -->
  <div class="games-grid" id="games-grid">
    {games.map((game) => <GameCard game={game} />)}
  </div>
</Layout>

<style>
  /* Hero */
  .games-hero {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  /* Live Chat */
  .live-chat-section {
    margin-bottom: 2rem;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: rgb(34, 197, 94);
    font-family: 'Courier New', monospace;
    letter-spacing: 3px;
    text-shadow: 0 0 20px rgba(34, 197, 94, 0.6);
    margin-bottom: 0.75rem;
    animation: glow-pulse 2.5s ease-in-out infinite alternate;
  }

  @keyframes glow-pulse {
    from { text-shadow: 0 0 10px rgba(34, 197, 94, 0.4), 0 0 20px rgba(34, 197, 94, 0.2); }
    to   { text-shadow: 0 0 20px rgba(34, 197, 94, 0.8), 0 0 40px rgba(34, 197, 94, 0.4); }
  }

  .hero-subtitle {
    color: rgb(156, 163, 175);
    font-size: 1rem;
    max-width: 560px;
    margin: 0 auto 0.5rem;
    font-family: 'Courier New', monospace;
  }

  .hero-count {
    color: rgba(34, 197, 94, 0.7);
    font-size: 0.85rem;
    font-family: 'Courier New', monospace;
  }

  .hero-invite {
    color: rgb(156, 163, 175);
    font-size: 0.9rem;
    font-family: 'Courier New', monospace;
    margin-top: 0.5rem;
  }

  .hero-invite a {
    color: rgb(34, 197, 94);
  }

  /* Daily challenge card (Competitive Phase 1) */
  .challenge-card {
    text-align: center;
    margin: 0 auto 2rem;
    max-width: 560px;
    padding: 1rem 1.25rem;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(34, 197, 94, 0.4);
    border-radius: 10px;
    font-family: 'Courier New', monospace;
  }

  .mh-hub-challenge {
    color: rgb(134, 239, 172);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .mh-hub-challenge .mh-challenge-label {
    color: rgb(34, 197, 94);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .mh-hub-challenge .mh-challenge-done {
    color: rgb(34, 211, 238);
    font-weight: bold;
  }

  .mh-hub-streak {
    color: #ffb347;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .mh-hub-streak:empty {
    display: none;
  }

  .challenge-play-btn {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: rgba(34, 197, 94, 0.15);
    color: rgb(34, 197, 94);
    border: 1px solid rgba(34, 197, 94, 0.5);
    border-radius: 6px;
    font-weight: bold;
    text-decoration: none;
  }

  .challenge-play-btn:hover {
    background: rgba(34, 197, 94, 0.3);
  }

  .mh-local-note {
    color: rgb(107, 114, 128);
    font-size: 0.8rem;
    margin: 0.6rem 0 0;
  }

  /* Controls */
  .controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .filter-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.45rem 1rem;
    background: rgba(0, 0, 0, 0.6);
    color: rgb(156, 163, 175);
    border: 1px solid rgba(34, 197, 94, 0.25);
    border-radius: 6px;
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-btn:hover {
    border-color: rgba(34, 197, 94, 0.6);
    color: rgb(134, 239, 172);
  }

  .filter-btn.active {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.7);
    color: rgb(34, 197, 94);
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.2);
  }

  .search-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .search-input {
    flex: 1;
    min-width: 200px;
    padding: 0.5rem 0.85rem;
    background: rgba(0, 0, 0, 0.7);
    color: rgb(134, 239, 172);
    border: 1px solid rgba(34, 197, 94, 0.35);
    border-radius: 6px;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-input::placeholder {
    color: rgb(75, 85, 99);
  }

  .search-input:focus {
    border-color: rgba(34, 197, 94, 0.7);
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.2);
  }

  .mobile-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: rgb(156, 163, 175);
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
  }

  .mobile-toggle input[type="checkbox"] {
    accent-color: rgb(34, 197, 94);
    width: 1rem;
    height: 1rem;
    cursor: pointer;
  }

  /* No results */
  .no-results {
    text-align: center;
    color: rgb(107, 114, 128);
    font-family: 'Courier New', monospace;
    font-size: 0.95rem;
    margin: 2rem 0;
  }

  /* Games grid */
  .games-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .games-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-title {
      font-size: 2rem;
      letter-spacing: 2px;
    }
  }

  @media (max-width: 560px) {
    .games-grid {
      grid-template-columns: 1fr;
    }

    .hero-title {
      font-size: 1.6rem;
    }
  }
</style>

<script>
  const grid = document.getElementById('games-grid') as HTMLElement;
  const noResults = document.getElementById('no-results') as HTMLElement;
  const searchInput = document.getElementById('game-search') as HTMLInputElement;
  const mobileOnly = document.getElementById('mobile-only') as HTMLInputElement;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');

  let activeCategory = 'all';

  function applyFilters() {
    const query = searchInput.value.toLowerCase().trim();
    const onlyMobile = mobileOnly.checked;
    const cards = grid.querySelectorAll<HTMLElement>('.game-card');
    let visible = 0;

    cards.forEach((card) => {
      const category = card.dataset.category ?? '';
      const name = card.dataset.name ?? '';
      const isMobile = card.dataset.mobile === 'true';

      const matchesCategory = activeCategory === 'all' || category === activeCategory;
      const matchesSearch = !query || name.includes(query);
      const matchesMobile = !onlyMobile || isMobile;

      const show = matchesCategory && matchesSearch && matchesMobile;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    noResults.hidden = visible > 0;
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      activeCategory = btn.dataset.filter ?? 'all';
      applyFilters();
    });
  });

  searchInput.addEventListener('input', applyFilters);
  mobileOnly.addEventListener('change', applyFilters);
</script>

<script src="/games/matrix-best.js" is:inline></script>
<script is:inline>
  // Competitive Phase 1 (HUB 155): fill hub-card bests, today's
  // challenge and the streak from device-local storage. Everything is
  // best-effort — if the module or storage is unavailable, the slots
  // simply stay empty/hidden and the hub works as before.
  (function () {
    if (!window.MatrixBest) return;
    try {
      document.querySelectorAll('[data-best-slug]').forEach(function (el) {
        var slug = el.getAttribute('data-best-slug');
        if (!slug || window.MatrixBest.games.indexOf(slug) === -1) return;
        var best = window.MatrixBest.getBest(slug);
        if (!best) return;
        var text = '';
        if (slug === 'memory-game') {
          var diffs = ['easy', 'medium', 'hard'];
          for (var i = 0; i < diffs.length; i++) {
            text = window.MatrixBest.formatBest(slug, best, diffs[i]);
            if (text) break;
          }
        } else {
          text = window.MatrixBest.formatBest(slug, best);
        }
        if (text) {
          el.textContent = text;
          el.hidden = false;
        }
      });

      var challenge = window.MatrixBest.getDailyChallenge();
      var wrap = document.getElementById('mh-hub-challenge-wrap');
      var challengeEl = document.getElementById('mh-hub-challenge');
      var playLink = document.getElementById('mh-hub-challenge-play');
      if (wrap && challengeEl && challenge) {
        window.MatrixBest.renderChallengeInto(challengeEl, null);
        if (playLink) playLink.setAttribute('href', '/games/play/' + challenge.game);
        window.MatrixBest.renderStreakInto(document.getElementById('mh-hub-streak'));
        wrap.hidden = false;
      }
    } catch (e) {
      // Local competitive data must never break the hub.
    }
  })();
</script>
