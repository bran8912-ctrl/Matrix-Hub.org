---
import Layout from "../../components/Layout.astro";
import MintSimulator from "../../components/proving-ground/MintSimulator";

export const prerender = true;

export const title = "How a Mint Works";
export const navCategory = "proving-ground";
---

<Layout title="How a Mint Works - The Proving Ground - Matrix Hub">
  <div class="container mx-auto px-4 py-8">
    <p class="mb-4">
      <a href="/proving-ground" class="text-green-400 hover:underline">
        ← Back to the Proving Ground
      </a>
    </p>

    <h1 class="text-4xl font-bold mb-4 text-green-400">🪙 How a Mint Works</h1>
    <p class="text-xl text-gray-300 mb-4">
      "Minting" sounds technical. It is four steps — and the last one is why
      the direct mint matters: the MTX lands in <em>your</em> wallet, not in
      a site account.
    </p>
    <p class="text-gray-300 mb-8">
      This is Module 2 of MTX 101's practice field. Run the simulation and
      watch each step. The rate it uses is read live from the MTX contract
      itself — the same figure the{' '}
      <a href="/buy-mtx" class="text-green-400 hover:underline">
        real mint page
      </a>{' '}
      works at.
    </p>

    <MintSimulator client:only="react" />

    <p class="text-sm text-gray-400 mt-8">
      The published facts behind this module — the mint rate, the supply,
      and the hard cap — live on{' '}
      <a class="text-green-400 hover:underline" href="/security">
        /security
      </a>
      . Next module:{' '}
      <a
        class="text-green-400 hover:underline"
        href="/proving-ground/verify-like-a-pro"
      >
        Read a Contract Like a Pro →
      </a>
    </p>
  </div>
</Layout>
