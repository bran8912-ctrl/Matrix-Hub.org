---
import Layout from "../components/Layout.astro";
import Wallet from "../components/Wallet.jsx";

export const prerender = true;

export const title = "Enhanced Wallet";
export const navCategory = "mtx-token";
---

<Layout title="Enhanced MTX Wallet - Matrix Hub">
  <div class="enhanced-wallet-page">
    <h1 class="page-title">Enhanced MTX Wallet</h1>
    <p class="page-description">
      Complete dashboard for managing your MTX tokens, viewing transaction history, and tracking your holdings.
    </p>
    
    <!-- Wallet Connection Component -->
    <div class="wallet-section">
      <Wallet client:only="react" />
    </div>

    <!-- Dashboard and Transaction History - Connected via state -->
    <div id="dashboard-section" class="dashboard-section">
      <div class="dashboard-container">
        <div id="mtx-dashboard"></div>
        <div id="mtx-transactions"></div>
      </div>
    </div>

    <div class="info-section">
      <h2>Features</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>💼 Wallet Connection</h3>
          <p>Connect your Polygon wallet (MetaMask or compatible) to access all features</p>
        </div>
        <div class="feature-card">
          <h3>📊 Dashboard</h3>
          <p>View comprehensive statistics including balance, tier, and total supply</p>
        </div>
        <div class="feature-card">
          <h3>📜 Transaction History</h3>
          <p>Track all your MTX transactions including sends, receives, mints, and burns</p>
        </div>
        <div class="feature-card">
          <h3>⚡ Quick Actions</h3>
          <p>Fast access to buy, trade, stake, and use your MTX tokens</p>
        </div>
        <div class="feature-card">
          <h3>🎯 Tier Progress</h3>
          <p>Track your progress towards the next tier with visual indicators</p>
        </div>
        <div class="feature-card">
          <h3>🔗 Blockchain Explorer</h3>
          <p>Direct links to Polygonscan for detailed transaction information</p>
        </div>
      </div>

      <h2>Usage Guide</h2>
      <ol class="usage-steps">
        <li>
          <strong>Connect Wallet:</strong> Click "Connect Wallet" to link your Polygon wallet
        </li>
        <li>
          <strong>View Dashboard:</strong> See your MTX balance, tier, and holdings at a glance
        </li>
        <li>
          <strong>Check Transactions:</strong> Review your transaction history and track activity
        </li>
        <li>
          <strong>Take Action:</strong> Use quick action buttons to buy, trade, or use your MTX
        </li>
        <li>
          <strong>Track Progress:</strong> Monitor your progress towards the next tier
        </li>
      </ol>

      <div class="security-notice">
        <h3>🔒 Security & Privacy</h3>
        <ul>
          <li>We never store your private keys or seed phrase</li>
          <li>All wallet interactions happen directly in your browser</li>
          <li>Transaction data is fetched directly from the blockchain</li>
          <li>Always verify contract addresses before interacting</li>
          <li>Keep your wallet software up to date</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { BrowserProvider } from 'ethers';
  import MTXDashboard from '../components/MTXDashboard.tsx';
  import MTXTransactionHistory from '../components/MTXTransactionHistory.tsx';
  import { getEthereumProvider } from '../utils/ethereumProvider';
  import { createRoot } from 'react-dom/client';
  import { createElement } from 'react';

  // Function to update dashboard and transaction history with connected address
  async function updateDashboardComponents() {
    const ethereum = getEthereumProvider();
    if (!ethereum) return;

    try {
      const provider = new BrowserProvider(ethereum);
      const signer = await provider.getSigner();
      const address = await signer.getAddress();

      // Render MTXDashboard
      const dashboardEl = document.getElementById('mtx-dashboard');
      if (dashboardEl && !dashboardEl.hasChildNodes()) {
        const dashboardRoot = createRoot(dashboardEl);
        dashboardRoot.render(createElement(MTXDashboard, { address }));
      }

      // Render MTXTransactionHistory
      const transactionsEl = document.getElementById('mtx-transactions');
      if (transactionsEl && !transactionsEl.hasChildNodes()) {
        const transactionsRoot = createRoot(transactionsEl);
        transactionsRoot.render(createElement(MTXTransactionHistory, { address }));
      }
    } catch (error) {
      console.log('Wallet not connected yet');
    }
  }

  // Listen for wallet connection events
  if (typeof window !== 'undefined') {
    // Check periodically if wallet is connected
    setInterval(() => {
      const dashboardEl = document.getElementById('mtx-dashboard');
      const transactionsEl = document.getElementById('mtx-transactions');
      
      if (dashboardEl && transactionsEl && (!dashboardEl.hasChildNodes() || !transactionsEl.hasChildNodes())) {
        updateDashboardComponents();
      }
    }, 1000);

    // Also check on account change
    const ethereum = getEthereumProvider();
    if (ethereum?.on) {
      ethereum.on('accountsChanged', () => {
        // Clear and re-render
        const dashboardEl = document.getElementById('mtx-dashboard');
        const transactionsEl = document.getElementById('mtx-transactions');
        if (dashboardEl) dashboardEl.innerHTML = '';
        if (transactionsEl) transactionsEl.innerHTML = '';
        updateDashboardComponents();
      });
    }
  }
</script>

<style>
  .enhanced-wallet-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .page-title {
    font-size: 2.5rem;
    color: var(--theme-primary);
    text-align: center;
    margin-bottom: 1rem;
    text-shadow: 0 0 15px var(--theme-glow);
    font-family: 'Courier New', monospace;
  }

  .page-description {
    text-align: center;
    font-size: 1.1rem;
    color: var(--theme-text);
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .wallet-section {
    margin: 2rem 0 3rem 0;
    display: flex;
    justify-content: center;
  }

  .dashboard-section {
    margin: 3rem 0;
  }

  .dashboard-container {
    display: grid;
    gap: 2rem;
  }

  #mtx-dashboard,
  #mtx-transactions {
    min-height: 200px;
  }

  .info-section {
    margin-top: 3rem;
    padding: 2rem;
    background: rgba(0, 255, 153, 0.05);
    border: 1px solid rgba(0, 255, 153, 0.2);
    border-radius: 12px;
  }

  .info-section h2 {
    color: var(--theme-primary);
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', monospace;
  }

  .info-section h3 {
    color: var(--theme-primary);
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    font-family: 'Courier New', monospace;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .feature-card {
    padding: 1.5rem;
    background: rgba(0, 255, 153, 0.05);
    border: 1px solid rgba(0, 255, 153, 0.2);
    border-radius: 8px;
  }

  .feature-card h3 {
    margin: 0 0 0.75rem 0;
    font-size: 1.1rem;
  }

  .feature-card p {
    margin: 0;
    color: var(--theme-text);
    opacity: 0.9;
    line-height: 1.5;
  }

  .usage-steps {
    list-style-position: inside;
    padding-left: 0;
    margin-bottom: 2rem;
  }

  .usage-steps li {
    padding: 0.75rem 0;
    color: var(--theme-text);
    line-height: 1.6;
  }

  .usage-steps strong {
    color: var(--theme-primary);
  }

  .security-notice {
    padding: 1.5rem;
    background: rgba(255, 153, 0, 0.05);
    border: 1px solid rgba(255, 153, 0, 0.3);
    border-radius: 8px;
  }

  .security-notice ul {
    list-style-type: none;
    padding-left: 0;
    margin-top: 1rem;
  }

  .security-notice li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--theme-text);
  }

  .security-notice li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #ff9900;
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .enhanced-wallet-page {
      padding: 1rem;
    }

    .page-title {
      font-size: 2rem;
    }

    .page-description {
      font-size: 1rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
