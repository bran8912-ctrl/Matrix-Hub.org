---
import Layout from "../components/Layout.astro";

export const prerender = true;

export const title = "Video Studio";

// ============================================================
// VIDEO STUDIO — ORDER & PAYMENT CONFIG (edit everything here)
// ============================================================
// PayPal account that receives client payments.
// Owner-confirmed Nov 12, 2026: bran8908@yahoo.com is Brandon's
// account for client payments.
// swap to PayPal.me handle here if Brandon provides one — if a
// PayPal.me handle is set, the Pay button should link to
// https://www.paypal.com/paypalme/<handle>/<amount> instead.
const PAYPAL_EMAIL = "bran8908@yahoo.com";
// Order requests are emailed to the same account via the visitor's
// own mail app (same browser-assisted intake pattern as /video —
// no payment is taken automatically on this page).
const ORDER_EMAIL = "bran8908@yahoo.com";
const CURRENCY = "USD";

const PACKAGES = [
  { id: "short-ad", tier: "Short Ad / Reel", price: 49, features: ["15–30s vertical video", "1 concept", "Voiceover + captions", "1 revision"] },
  { id: "product-video", tier: "Product Video", price: 149, features: ["30–60s product video", "Your photos animated", "2 concepts, 2 revisions", "9:16 + 16:9 versions"] },
  { id: "short-scene", tier: "Short Movie Scene", price: 249, features: ["Multi-scene short (up to ~90s)", "Consistent character", "Script + storyboard approval", "2 revisions"] },
];

const STEPS = [
  { step: "1. Brief", text: "Tell us about your business, your offer, and the style you want — use the order form below or build a storyboard first on the generator page." },
  { step: "2. Storyboard approval", text: "We draft the shot list and script and send it to you for approval before any rendering starts. Nothing is made until you say go." },
  { step: "3. Draft video", text: "We produce your video — animated scenes, voiceover, captions, music — and send you a draft to review." },
  { step: "4. Final MP4 delivery", text: "After your revisions, you get the finished MP4 (9:16, 16:9, or 1:1), yours to post anywhere." },
];
---

<Layout title="Video Studio — AI Video Ads for Local Businesses - Matrix Hub">
  <div class="video-page">
    <div class="video-header">
      <h1 class="page-title">MATRIX HUB VIDEO STUDIO</h1>
      <p class="page-subtitle">
        AI video ads and short movie scenes for local businesses — made to order by a real
        studio team, delivered as finished MP4s you can post anywhere.
      </p>
      <p class="disclosure-note">All videos from this studio are AI-generated and are labelled as such.</p>
    </div>

    <section>
      <h2 class="section-title">SEE IT IN ACTION — DEMOS</h2>
      <p class="hint center">Demo videos below are AI-generated samples for a fictional business. Your video is made to order after we confirm your brief.</p>
      <div class="demo-grid">
        <figure class="demo-card">
          <video controls preload="metadata" poster="/demos/sample-reel-03.jpg" playsinline>
            <source src="/demos/sample-reel-03.mp4" type="video/mp4" />
            Your browser does not support embedded video.
          </video>
          <figcaption>
            <strong>Coffee Shop Ad — 25s vertical ad (demo, fictional business)</strong>
            <span class="demo-meta">Our current cut: hook-first script, studio voiceover, word-by-word captions, licensed music bed.</span>
            <span class="music-credit">Music: "Bossa Antigua" Kevin MacLeod (incompetech.com) — Licensed under Creative Commons: By Attribution 4.0 License http://creativecommons.org/licenses/by/4.0/</span>
          </figcaption>
        </figure>
        <figure class="demo-card">
          <video controls preload="metadata" poster="/demos/sample-reel-02.jpg" playsinline>
            <source src="/demos/sample-reel-02.mp4" type="video/mp4" />
            Your browser does not support embedded video.
          </video>
          <figcaption>
            <strong>Same ad — earlier cut (demo, fictional business)</strong>
            <span class="demo-meta">The version before our quality pass — compare the pacing, captions, and finish.</span>
          </figcaption>
        </figure>
      </div>
      <p class="hint center">Want to sketch your own first? <a class="inline-link" href="/video">Try the generator / request a custom video →</a></p>
    </section>

    <section>
      <h2 class="section-title">PACKAGES</h2>
      <p class="hint center">Your price is quoted and confirmed with you before any work starts. Orders of $100 or more start with a 50% deposit, balance on delivery; orders under $100 are paid in full up front. Add-ons: extra revision $25 · extra format $25 · hook A/B variant $35 · rush 24-hour delivery $49. We deliver a finished video; we never promise sales, views, or results — what a video earns depends on your offer and your audience.</p>
      <div class="tools-grid">
        {PACKAGES.map((p) => (
          <div class="tool-card">
            <div class="tool-header"><span class="price">${p.price}</span></div>
            <h3 class="tool-title">{p.tier}</h3>
            <div class="tool-features">{p.features.map((f) => (<span class="feature-tag">{f}</span>))}</div>
            <button type="button" class="tool-cta select-package" data-package={p.id}>Select {p.tier} — ${p.price}</button>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="section-title">HOW IT WORKS</h2>
      <div class="tools-grid">
        {STEPS.map((s) => (
          <div class="tool-card">
            <h3 class="tool-title">{s.step}</h3>
            <p class="tool-description">{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="studio-card" id="order">
      <h2>🧾 ORDER &amp; PAY</h2>
      <p class="hint">
        Pick a package, tell us about the project, then pay or send a payment request.
        We confirm your brief with you before production starts — if we can't make what
        you asked for, we tell you before any work begins.
      </p>

      <label class="pkg-label">Package
        <select id="o-package">
          {PACKAGES.map((p) => (<option value={p.id}>{p.tier} — ${p.price}</option>))}
        </select>
      </label>
      <p class="order-amount">Amount: <strong id="o-amount">$49 USD</strong> </p>

      <div class="pay-row">
        <a id="paypal-btn" class="tool-cta pay-btn" href="#" target="_blank" rel="noopener">Pay with PayPal</a>
        <button id="gpay-btn" type="button" class="tool-cta pay-btn">Request Google Pay</button>
      </div>
      <p class="hint">Choose Google Pay and send your order — we reply with a Google Pay payment request. (Google Pay has no public pay-by-link for personal accounts, so the request comes from us after you order.)</p>

      <form id="order-form" class="brief-form">
        <label>Business name
          <input id="o-business" type="text" placeholder="e.g. Sunrise Coffee — Farmington" required />
        </label>
        <label>Contact email
          <input id="o-email" type="email" placeholder="you@yourbusiness.com" required />
        </label>
        <label>How would you like to pay?
          <select id="o-paymethod">
            <option value="PayPal">PayPal</option>
            <option value="Google Pay">Google Pay</option>
            <option value="Decide after brief confirmation">Decide after brief confirmation</option>
          </select>
        </label>
        <label>Project details
          <textarea id="o-details" rows="5" placeholder="What are you promoting? Any offer, style, deadline, or must-have details?" required></textarea>
        </label>
        <button type="submit" class="tool-cta">Send order request →</button>
        <p id="order-note" class="hint" hidden></p>
      </form>
    </section>

    <div class="footer-card">
      <h2>🤖 AI Disclosure</h2>
      <p>Videos from Matrix Hub Video Studio are generated with AI tools and human review. Every delivered video carries an “AI-generated video — Matrix Hub Video Studio” end card. We only use licensed, owned, or client-supplied assets, and we never clone a voice without written consent. Demo videos on this page are AI-generated samples for a fictional business.</p>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ PAYPAL_EMAIL, ORDER_EMAIL, CURRENCY, PACKAGES }}>
  (function () {
    var pkgSelect = document.getElementById('o-package');
    var amountEl = document.getElementById('o-amount');
    var paypalBtn = document.getElementById('paypal-btn');
    var payMethod = document.getElementById('o-paymethod');
    if (!pkgSelect || !paypalBtn) return;

    function currentPackage() {
      for (var i = 0; i < PACKAGES.length; i++) {
        if (PACKAGES[i].id === pkgSelect.value) return PACKAGES[i];
      }
      return PACKAGES[0];
    }

    function refresh() {
      var p = currentPackage();
      amountEl.textContent = '$' + p.price + ' ' + CURRENCY;
      var href = 'https://www.paypal.com/cgi-bin/webscr?cmd=_xclick' +
        '&business=' + encodeURIComponent(PAYPAL_EMAIL) +
        '&item_name=' + encodeURIComponent('Matrix Hub Video Studio — ' + p.tier) +
        '&amount=' + encodeURIComponent(p.price.toFixed(2)) +
        '&currency_code=' + encodeURIComponent(CURRENCY);
      paypalBtn.setAttribute('href', href);
    }

    pkgSelect.addEventListener('change', refresh);
    refresh();

    var cards = document.querySelectorAll('.select-package');
    cards.forEach(function (btn) {
      btn.addEventListener('click', function () {
        pkgSelect.value = btn.getAttribute('data-package');
        refresh();
        document.getElementById('order').scrollIntoView({ behavior: 'smooth' });
      });
    });

    document.getElementById('gpay-btn').addEventListener('click', function () {
      payMethod.value = 'Google Pay';
      document.getElementById('order-form').scrollIntoView({ behavior: 'smooth' });
      var note = document.getElementById('order-note');
      note.hidden = false;
      note.textContent = 'Google Pay selected. Send the order form below and we will reply with a Google Pay payment request.';
    });

    document.getElementById('order-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var p = currentPackage();
      var biz = document.getElementById('o-business').value.trim();
      var email = document.getElementById('o-email').value.trim();
      var details = document.getElementById('o-details').value.trim();
      var method = payMethod.value;
      var subject = 'Video Studio order — ' + p.tier + ' ($' + p.price + ') — ' + biz;
      var body = [
        'New Video Studio order request',
        '',
        'Package: ' + p.tier + ' — $' + p.price + ' ' + CURRENCY + '',
        'Business: ' + biz,
        'Contact email: ' + email,
        'Payment method: ' + method,
        '',
        'Project details:',
        details
      ].join('\n');
      var note = document.getElementById('order-note');
      note.hidden = false;
      note.textContent = method === 'Google Pay'
        ? 'Opening your mail app to send this order. We reply to your contact email with a Google Pay payment request after confirming your brief.'
        : 'Opening your mail app to send this order. Prefer to pay now? Use the Pay with PayPal button above — we still confirm your brief with you before production starts.';
      window.location.href = 'mailto:' + ORDER_EMAIL + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    });
  })();
</script>

<style>
  .video-page { width: 100%; padding: 2rem 0; }
  .video-header { text-align: center; margin-bottom: 2.5rem; }
  .page-title { font-size: 2.8rem; color: var(--theme-primary); text-shadow: 0 0 20px var(--theme-glow); font-family: 'Courier New', monospace; letter-spacing: 4px; margin-bottom: 1rem; }
  .page-subtitle { font-size: 1.1rem; color: var(--theme-text); max-width: 700px; margin: 0 auto; opacity: 0.9; }
  .disclosure-note { color: var(--theme-primary); margin-top: 0.75rem; font-size: 0.9rem; }
  .section-title { font-size: 1.8rem; color: var(--theme-primary); margin: 2.5rem 0 1.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid rgba(0,255,153,0.3); font-family: 'Courier New', monospace; }
  .studio-card, .footer-card { background: rgba(0,255,153,0.08); border: 1px solid rgba(0,255,153,0.3); border-radius: 8px; padding: 2rem; max-width: 800px; margin: 0 auto 2rem; }
  .studio-card h2, .footer-card h2 { color: var(--theme-primary); margin-bottom: 1rem; }
  .footer-card p { color: var(--theme-text); opacity: 0.9; line-height: 1.6; }
  .hint { color: var(--theme-text); opacity: 0.8; font-size: 0.9rem; line-height: 1.5; }
  .hint.center { text-align: center; max-width: 760px; margin: 0 auto 1rem; }
  .inline-link { color: var(--theme-primary); }
  .demo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 420px)); gap: 1.5rem; justify-content: center; margin-bottom: 1rem; }
  .demo-card { background: rgba(0,0,0,0.5); border: 1px solid rgba(0,255,153,0.25); border-radius: 8px; padding: 1rem; margin: 0; }
  .demo-card video { width: 100%; max-height: 480px; border-radius: 6px; background: #000; }
  .demo-card figcaption { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.75rem; color: var(--theme-text); }
  .demo-card figcaption strong { color: var(--theme-primary); font-family: 'Courier New', monospace; font-size: 1rem; }
  .demo-meta { opacity: 0.85; font-size: 0.9rem; line-height: 1.45; }
  .music-credit { opacity: 0.7; font-size: 0.78rem; line-height: 1.4; }
  .brief-form { display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem; }
  .brief-form label, .pkg-label { display: flex; flex-direction: column; gap: 0.4rem; color: var(--theme-text); font-size: 0.95rem; }
  .brief-form input, .brief-form select, .brief-form textarea, .pkg-label select { background: rgba(0,0,0,0.5); border: 1px solid rgba(0,255,153,0.35); border-radius: 4px; color: var(--theme-text); padding: 0.7rem; font-size: 1rem; }
  .pkg-label { margin-top: 1rem; }
  .order-amount { color: var(--theme-text); font-size: 1.1rem; margin: 1rem 0 0.5rem; display: flex; align-items: center; gap: 0.75rem; }
  .order-amount strong { color: var(--theme-primary); font-family: 'Courier New', monospace; font-size: 1.4rem; }
  .pay-row { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1rem 0 0.5rem; }
  .tool-cta { background: linear-gradient(135deg, rgba(0,255,153,0.3), rgba(0,255,153,0.1)); border: 1px solid rgba(0,255,153,0.4); color: var(--theme-primary); padding: 0.75rem 1rem; border-radius: 4px; text-align: center; font-weight: bold; cursor: pointer; font-size: 1rem; text-decoration: none; }
  .tool-cta:hover { background: rgba(0,255,153,0.2); }
  .pay-btn { flex: 1 1 220px; }
  .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
  .tool-card { background: rgba(0,0,0,0.5); border: 1px solid rgba(0,255,153,0.2); border-radius: 8px; padding: 1.5rem; display: flex; flex-direction: column; }
  .tool-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .price { font-size: 2rem; color: var(--theme-primary); font-family: 'Courier New', monospace; }
  .tool-badge { background: rgba(0,255,153,0.2); color: var(--theme-primary); padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; }
  .tool-title { font-size: 1.25rem; color: var(--theme-primary); margin-bottom: 0.5rem; font-family: 'Courier New', monospace; }
  .tool-description { color: var(--theme-text); font-size: 0.95rem; margin-bottom: 1rem; opacity: 0.9; flex-grow: 1; line-height: 1.5; }
  .tool-features { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .feature-tag { background: rgba(0,255,153,0.1); color: var(--theme-primary); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; text-transform: uppercase; }
  .select-package { margin-top: auto; }
  @media (max-width: 768px) { .page-title { font-size: 2rem; letter-spacing: 2px; } .tools-grid { grid-template-columns: 1fr; } }
</style>
