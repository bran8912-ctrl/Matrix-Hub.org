---
import Layout from "../../../components/Layout.astro";
import LessonDeck from "../../../components/clubhouse/LessonDeck";
import { LESSONS } from "../../../lib/lessons-data";

export const prerender = true;

export const title = "MTX 101 Lesson 10 — Supply + the hard cap, in plain numbers";
export const navCategory = "clubhouse";

const lesson = LESSONS[9];
---

<Layout title="Lesson 10: Supply + the hard cap, in plain numbers - MTX 101 Classroom - Matrix Hub">
  <div class="container mx-auto px-4 py-8">
    <p class="mb-2 text-sm text-green-300/80">
      <a href="/clubhouse/classroom" class="hover:text-green-300">← MTX 101 Classroom</a>
    </p>
    <h1 class="text-4xl font-bold mb-3 text-green-400">{lesson.title}</h1>
    <p class="text-xl text-gray-300 mb-8">{lesson.subtitle}</p>

    <LessonDeck
      client:load
      lesson={lesson}
      lessonNumber={10}
      totalLessons={LESSONS.length}
      nextHref="/clubhouse/classroom/lesson-11"
    />

    <div class="mt-10 bg-gray-800 border border-gray-600 rounded-lg p-6">
      <h2 class="text-xl font-bold text-green-400 mb-2">About this lesson</h2>
      <p class="text-gray-300">
        Adapted from the approved MTX 101 post "Supply, in Plain Numbers"
        (Anya Kowalski's education series — Topic 9). Facts checked against
        the 2026-11-12 public proof pack: total supply 105,100 MTX and the
        hard cap of 100,000,000 MTX, both read on-chain. The proof page is{' '}
        <a href="/security" class="text-green-300 underline">matrix-hub.org/security</a>{' '}
        — it links to the contract on PolygonScan, where you can read both
        numbers yourself.
      </p>
    </div>
  </div>
</Layout>
