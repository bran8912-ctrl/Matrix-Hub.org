---
import Layout from "../../../components/Layout.astro";
import LessonDeck from "../../../components/clubhouse/LessonDeck";
import { LESSONS } from "../../../lib/lessons-data";

export const prerender = true;

export const title = "MTX 101 Lesson 12 — Dice, Chainlink VRF fairness, and stuck-bet refund protection";
export const navCategory = "clubhouse";

const lesson = LESSONS[11];
---

<Layout title="Lesson 12: Dice, Chainlink VRF fairness, and stuck-bet refund protection - MTX 101 Classroom - Matrix Hub">
  <div class="container mx-auto px-4 py-8">
    <p class="mb-2 text-sm text-green-300/80">
      <a href="/clubhouse/classroom" class="hover:text-green-300">← MTX 101 Classroom</a>
    </p>
    <h1 class="text-4xl font-bold mb-3 text-green-400">{lesson.title}</h1>
    <p class="text-xl text-gray-300 mb-8">{lesson.subtitle}</p>

    <LessonDeck
      client:load
      lesson={lesson}
      lessonNumber={12}
      totalLessons={LESSONS.length}
      nextHref="/clubhouse/classroom/lesson-13"
    />

    <div class="mt-10 bg-gray-800 border border-gray-600 rounded-lg p-6">
      <h2 class="text-xl font-bold text-green-400 mb-2">About this lesson</h2>
      <p class="text-gray-300">
        Adapted from Anya Kowalski's approved MTX 101 education series —
        the paired Topics 11 + 12 post on Dice and the stuck-bet refund
        rule. Every figure is checked against the 2026-11-12 public
        proof pack, including its stuck-bet amendment: bets of 1–1,000
        MTX with a maximum payout per bet of 100 MTX, routed on-chain
        88% payout side / 6% liquidity / 4% reserve / 2% development,
        results decided by Chainlink VRF, and a full-stake refund —
        operator-run — once a bet has waited 3,600 seconds for a result
        that never arrived. Stated as plainly as the proof pack states
        it: the casino is brand new, and no bets have been placed on it
        yet. Dice is a gambling game — 18+ only, and only where online
        wagering is legal; the contract addresses and on-chain proof
        are on{' '}
        <a href="/security" class="text-green-300 underline">matrix-hub.org/security</a>.
      </p>
    </div>
  </div>
</Layout>
