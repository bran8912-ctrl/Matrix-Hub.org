---
import Layout from "../../../components/Layout.astro";
import LessonDeck from "../../../components/clubhouse/LessonDeck";
import { LESSONS } from "../../../lib/lessons-data";

export const prerender = true;

export const title = "MTX 101 Lesson 7 — Spotting the Fake Token";
export const navCategory = "clubhouse";

const lesson = LESSONS[6];
---

<Layout title="Lesson 7: Spotting the Fake Token - MTX 101 Classroom - Matrix Hub">
  <div class="container mx-auto px-4 py-8">
    <p class="mb-2 text-sm text-green-300/80">
      <a href="/clubhouse/classroom" class="hover:text-green-300">← MTX 101 Classroom</a>
    </p>
    <h1 class="text-4xl font-bold mb-3 text-green-400">{lesson.title}</h1>
    <p class="text-xl text-gray-300 mb-8">{lesson.subtitle}</p>

    <LessonDeck
      client:load
      lesson={lesson}
      lessonNumber={7}
      totalLessons={LESSONS.length}
      nextHref="/clubhouse/classroom/lesson-8"
    />

    <div class="mt-10 bg-gray-800 border border-gray-600 rounded-lg p-6">
      <h2 class="text-xl font-bold text-green-400 mb-2">About this lesson</h2>
      <p class="text-gray-300">
        Adapted from the approved MTX 101 post "Spotting the Fake Token"
        (Anya Kowalski's education series). Facts checked against the
        2026-11-12 public proof pack; the proof page is{' '}
        <a href="/security" class="text-green-300 underline">matrix-hub.org/security</a>.
        The fake address appears in this lesson only as a labelled warning.
        Practise spotting it in{' '}
        <a href="/proving-ground/spot-the-fake" class="text-green-300 underline">Spot the Fake</a>{' '}
        in the Proving Ground.
      </p>
    </div>
  </div>
</Layout>
