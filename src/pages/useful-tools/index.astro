---
import Layout from "../../components/Layout.astro";
import LiveChat from "../../components/LiveChat.tsx";

export const prerender = true;

export const title = "Free Financial Tools";
export const navCategory = "useful-tools";

// ── Financial & Swarm Intelligence Tools ─────────────────────────────────────
const TOOLS = [
  // ── Swarm-Intelligence / AI Agent Finance ─────────────────────────────────
  {
    category: "swarm-ai",
    label: "SWARM AI ENGINE",
    emoji: "🐝",
    title: "MiroFish",
    description:
      "Open-source universal swarm intelligence engine for prediction and analysis. Spawns thousands of autonomous AI agents that simulate collective behavior to produce prediction reports for finance, markets, politics, and more. Knowledge-graph extraction, multi-agent simulation, and configurable agent personalities.",
    github: "https://github.com/666ghj/MiroFish",
    stars: "★ Trending",
    badge: "SWARM AI",
    badgeColor: "#00ff99",
    tags: ["swarm", "prediction", "finance", "multi-agent"],
  },
  {
    category: "swarm-ai",
    label: "AUTO HEDGE FUND",
    emoji: "🤖",
    title: "AutoHedge",
    description:
      "Autonomous AI hedge fund powered by swarm intelligence. Multiple specialized agents handle trading strategies, technical analysis, statistical modeling, risk management, and live execution. JSON-based institutional-grade output with modular agent design.",
    github: "https://github.com/The-Swarm-Corporation/AutoHedge",
    stars: "The-Swarm-Corporation",
    badge: "AUTONOMOUS",
    badgeColor: "#bf00ff",
    tags: ["hedge-fund", "trading", "swarm", "automation"],
  },
  {
    category: "portfolio",
    label: "PORTFOLIO RISK",
    emoji: "📊",
    title: "Volara",
    description:
      "Open-source portfolio risk management and analysis system built with real-time data processing and advanced ML models. Risk assessment for stocks, derivatives, and bonds; real-time updates; extensible risk metrics; portfolio optimization; and API integration.",
    github: "https://github.com/The-Swarm-Corporation/Volara",
    stars: "The-Swarm-Corporation",
    badge: "RISK MGMT",
    badgeColor: "#00aaff",
    tags: ["portfolio", "risk", "ML", "real-time"],
  },
  {
    category: "swarm-ai",
    label: "CURATED AGENTS",
    emoji: "📋",
    title: "Awesome Financial Agents",
    description:
      "Curated GitHub list of agent-based frameworks and tools focused on financial analysis and trading. Covers frameworks like Tickr Agent and open-aladdin, specialised crypto and stock analysis agents, and step-by-step guides for building multi-agent financial systems.",
    github: "https://github.com/The-Swarm-Corporation/awesome-financial-agents",
    stars: "The-Swarm-Corporation",
    badge: "CURATED LIST",
    badgeColor: "#FFD700",
    tags: ["agents", "finance", "curated", "frameworks"],
  },

  // ── Portfolio Optimisation ─────────────────────────────────────────────────
  {
    category: "portfolio",
    label: "PORTFOLIO OPT",
    emoji: "⚖️",
    title: "PyPortfolioOpt",
    description:
      "Python library for financial portfolio optimization. Implements classical mean-variance optimization, Black-Litterman allocation, risk models (sample covariance, Ledoit-Wolf, semi-covariance), and efficient frontier generation. Battle-tested and widely used.",
    github: "https://github.com/robertmartin8/PyPortfolioOpt",
    stars: "★ 4k+",
    badge: "OPEN SOURCE",
    badgeColor: "#00ff99",
    tags: ["python", "portfolio", "optimization", "quant"],
  },
  {
    category: "analysis",
    label: "FINANCIAL TOOLKIT",
    emoji: "🔧",
    title: "FinanceToolkit",
    description:
      "Comprehensive open-source financial analysis toolkit. Covers 150+ financial ratios and performance measurements including fundamental analysis, technical indicators, risk metrics, and factor analysis. Works with any stock or asset.",
    github: "https://github.com/JerBouma/FinanceToolkit",
    stars: "★ 3.5k+",
    badge: "150+ METRICS",
    badgeColor: "#00aaff",
    tags: ["toolkit", "analysis", "ratios", "technicals"],
  },

  // ── Market Data & Crypto ───────────────────────────────────────────────────
  {
    category: "crypto",
    label: "CRYPTO ANALYSIS",
    emoji: "₿",
    title: "Freqtrade",
    description:
      "Free and open-source crypto trading bot written in Python. Supports backtesting, plotting, machine learning optimization, and paper and live trading on major exchanges. Strategy-first design — write your own logic or use community strategies.",
    github: "https://github.com/freqtrade/freqtrade",
    stars: "★ 33k+",
    badge: "TRADING BOT",
    badgeColor: "#FFD700",
    tags: ["crypto", "bot", "backtesting", "python"],
  },
  {
    category: "analysis",
    label: "QUANT RESEARCH",
    emoji: "📈",
    title: "QuantLib",
    description:
      "Industry-standard quantitative finance library. Pricing of bonds, options, swaps, interest-rate models, yield curves, and Monte Carlo simulations. Used by banks, hedge funds, and quant researchers worldwide. Available in Python, C++, and more.",
    github: "https://github.com/lballabio/QuantLib",
    stars: "★ 5k+",
    badge: "INDUSTRY STD",
    badgeColor: "#ff6600",
