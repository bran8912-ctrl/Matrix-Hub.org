// Build category filter list
const CATEGORIES = [
  { key: "all",       label: "⚡ ALL TOOLS",           count: TOOLS.length },
  { key: "swarm-ai",  label: "🐝 Swarm AI",            count: TOOLS.filter(t => t.category === "swarm-ai").length },
  { key: "portfolio", label: "⚖️ Portfolio",            count: TOOLS.filter(t => t.category === "portfolio").length },
  { key: "analysis",  label: "📈 Analysis",             count: TOOLS.filter(t => t.category === "analysis").length },
  { key: "crypto",    label: "₿ Crypto",               count: TOOLS.filter(t => t.category === "crypto").length },
];
---

<Layout title="Free Financial Tools — Matrix Hub">
  <div class="tools-page">

    <!-- ── Page Header ──────────────────────────────────────────────────── -->
    <div class="page-header">
      <div class="header-badge">FINANCIAL TOOLS</div>
      <h1 class="page-title">FREE FINANCIAL TOOLS</h1>
      <p class="page-subtitle">
        Live market charts and financial analysis tools — usable right here on Matrix Hub.<br />
        Plus a curated directory of open-source swarm-intelligence frameworks to self-host.
      </p>
    </div>

    <!-- LIVE CHAT FEED -->
    <div class="live-chat-section">
      <LiveChat
        client:only="react"
        roomId="useful-tools"
        roomLabel="📈 Trading & Tools Chat"
        allowedTopics={[
          "trading", "market", "portfolio", "stocks", "crypto", "defi",
          "technical analysis", "indicators", "rsi", "macd", "moving average",
          "quant", "risk", "swarm", "financial", "tools", "tips", "strategies",
          "backtesting", "freqtrade", "quantlib", "options", "bonds",
          "yields", "analysis",
        ]}
        botName="📊 FinBot"
        botTips={[
          // ── BTC buy/short signals ────────────────────────────────────────
          "📊 [Chart Scanner] BTC/USDT — Watch the 1H chart: if RSI drops below 30 and price bounces off a key support level (e.g. a prior weekly low), that's a potential long setup. Confirm with a bullish engulfing candle. ⚠️ Not financial advice.",
          "📊 [Chart Scanner] BTC/USDT — Potential short signal: if BTC is rejected at a major resistance (previous ATH zone or 200-day MA) and RSI is overbought above 70 on the daily, consider watching for a reversal candle as a short entry. ⚠️ Not financial advice.",
          "📊 [Chart Scanner] BTC/USDT — Breakout watch: if BTC consolidates tightly for 3–5 candles below a resistance level on the 4H chart, a high-volume breakout above it can be a strong long signal. Volume confirmation is key. ⚠️ Not financial advice.",
          "📊 [Chart Scanner] BTC/USDT — MACD signal: when the MACD line crosses above the signal line on the daily chart after an extended downtrend, it can signal a momentum shift. Most reliable when the crossover happens below the zero line (i.e. from deeply negative territory). ⚠️ Not financial advice.",
          "📊 [Chart Scanner] BTC/USDT — Fibonacci retracement: after a significant BTC rally, pull a Fib from the swing low to swing high. The 0.618 level (~61.8% retracement) is statistically the strongest support zone and often acts as a high-probability long entry. ⚠️ Not financial advice.",

          // ── ETH buy/short signals ────────────────────────────────────────
          "📊 [Chart Scanner] ETH/USDT — Look for the ETH/BTC pair in the screener below: when ETH outperforms BTC (ETH/BTC rising), ETH is often worth rotating into for a long. ⚠️ Not financial advice.",
          "📊 [Chart Scanner] ETH/USDT — Short setup: if ETH fails to break above a descending trendline on the 4H chart and the MACD histogram is crossing bearish, that convergence can signal downside momentum. ⚠️ Not financial advice.",
          "📊 [Chart Scanner] ETH/USDT — Gas fee watch: extremely high ETH gas fees often coincide with market tops (high on-chain activity = euphoria). Check gas trackers when ETH is making new highs — sustained gas spikes can precede corrections. ⚠️ Not financial advice.",
          "📊 [Chart Scanner] ETH/USDT — Stochastic RSI signal: when Stoch RSI is below 20 and both lines curl upward on the 4H chart, this is one of the earliest momentum reversal signals available — often fires before regular RSI crosses. ⚠️ Not financial advice.",

          // ── Altcoin screener signals ─────────────────────────────────────
          "🔍 [Screener Scan] Open the Crypto Market Screener below and sort by '% Change 24h' descending — assets with unusually high volume AND positive price change are often breaking out. Cross-check on the chart above before acting. ⚠️ Not financial advice.",
          "🔍 [Screener Scan] In the Screener below, filter by RSI < 35 to find potentially oversold crypto assets. These aren't automatic buys — check the chart trend first. Oversold in a downtrend can keep going lower. ⚠️ Not financial advice.",
          "🔍 [Screener Scan] Scan for coins where RSI is between 50–60 and price is above the 50-day MA — these are often in healthy uptrends with room to run. Use the Screener below to find candidates. ⚠️ Not financial advice.",
          "🔍 [Screener Scan] Check SOL, BNB, and ADA in the Screener — compare their 24h volume vs 7-day average. A volume spike above 2× average alongside a price breakout is a historically strong continuation signal. ⚠️ Not financial advice.",
          "🔍 [Screener Scan] Use the Screener to identify altcoins with rising Relative Strength vs BTC (RS line trending up). When an altcoin holds value or rises while BTC corrects, it signals institutional accumulation or a structural shift — strong candidates for the next leg up. ⚠️ Not financial advice.",
          "🔍 [Screener Scan] Look for altcoins that have compressed into a tight range (low ATR / low Bollinger Band width) in the Screener. Low-volatility compression often precedes explosive breakouts — these are breakout setups in formation. ⚠️ Not financial advice.",

          // ── Ticker tape signals ──────────────────────────────────────────
          "📡 [Ticker Watch] Keep an eye on the live ticker above — if DOGE or XRP show sudden spikes in the daily % change, check the chart. Meme/news-driven pumps often have sharp reversals, making them potential short setups after the euphoria peak. ⚠️ Not financial advice.",
          "📡 [Ticker Watch] Watch the S&P 500 (SPX) in the ticker — crypto often lags SPX moves by 24–48h. If SPX drops sharply, risk-off sentiment may hit BTC and altcoins next. Consider reducing leverage exposure early. ⚠️ Not financial advice.",
          "📡 [Ticker Watch] Monitor NVDA in the ticker alongside BTC. Tech and crypto sentiment are increasingly correlated — a sharp NVDA selloff often acts as an early warning of broader risk-off across all speculative assets. ⚠️ Not financial advice.",

          // ── NVDA / AAPL equity signals ───────────────────────────────────
          "📈 [Chart Scanner] NVDA — Pull up NVDA on the chart above (Quick switch). If it's building higher lows on the 4H and holds above the 50-day MA, the trend is bullish and momentum favors longs. ⚠️ Not financial advice.",
          "📈 [Chart Scanner] NVDA earnings watch: IV (implied volatility) on NVDA options spikes before earnings — buying options pre-earnings often leads to 'IV crush' after the report regardless of direction. Sell-the-news setups are worth watching. ⚠️ Not financial advice.",
          "📈 [Chart Scanner] AAPL — A classic mean-reversion play: if AAPL dips 5–8% from a recent high on low-volume selling, it has historically attracted institutional buying. Look for a hammer candle on the daily chart as a potential entry signal. ⚠️ Not financial advice.",
          "📈 [Chart Scanner] AAPL short setup: if AAPL gaps up into earnings above the upper Bollinger Band and RSI is above 75 on the daily, a short-term short (or protective put) to fade the gap can be worth watching. ⚠️ Not financial advice.",

          // ── MACD & momentum indicators ───────────────────────────────────
          "💡 [TA Signal — MACD] A bullish MACD divergence (price making lower lows, MACD making higher lows) on the daily chart is one of the highest-conviction reversal signals in crypto. Add it to your indicator panel on the chart above and watch for it at key support zones. ⚠️ Not financial advice.",
          "💡 [TA Signal — MACD] MACD histogram shrinking toward zero during an uptrend is a warning that momentum is fading — not a reversal signal yet, but worth tightening stop-losses on active longs. ⚠️ Not financial advice.",

          // ── Volume analysis ──────────────────────────────────────────────
          "💡 [TA Signal — Volume] Volume is the fuel of price moves. A breakout on below-average volume is a 'fakeout' candidate — high probability of reverting. Always confirm directional moves with at least 1.5× average volume on the breakout candle. ⚠️ Not financial advice.",
          "💡 [TA Signal — Volume] On-Balance Volume (OBV) divergence: if price is making new highs but OBV is declining, smart money is quietly distributing — potential topping signal. Add OBV to the chart above to test it on any asset. ⚠️ Not financial advice.",

          // ── Market structure ─────────────────────────────────────────────
          "💡 [TA Signal] On any asset in the chart above: when the 20-EMA crosses above the 50-EMA on the 1H chart ('golden cross' on intraday), it often marks the start of a short-term bullish run. Higher timeframe confirmation improves the signal quality. ⚠️ Not financial advice.",
          "💡 [TA Signal] Potential short setup on any chart: when price makes a 'lower high' after a failed retest of a previous high and the RSI also makes a lower high — that RSI divergence is a bearish signal. ⚠️ Not financial advice.",
          "💡 [TA Signal] Support/Resistance flip: a level that previously acted as resistance, once broken and retested from above, often becomes support (S/R flip). These retests can be high-probability long entry points on the chart above. ⚠️ Not financial advice.",
          "💡 [TA Signal — Market Structure] Higher highs and higher lows = bullish structure. Lower highs and lower lows = bearish structure. Any deviation from the prevailing structure is the first signal that a trend change may be underway. Mark these swing points on the chart above. ⚠️ Not financial advice.",
          "💡 [TA Signal — Wyckoff] Watch for 'spring' patterns at support: a brief dip below a key support level followed by an immediate reclaim (spring + sign of strength) is a Wyckoff accumulation signal. Particularly reliable on BTC and ETH daily charts. ⚠️ Not financial advice.",

          // ── Risk management ──────────────────────────────────────────────
          "🛡️ [Risk Management] Never risk more than 1–2% of your total portfolio on a single trade. This lets you sustain 50 consecutive losses before losing half your capital — giving strategies time to play out without catastrophic drawdown. ⚠️ Not financial advice.",
          "🛡️ [Risk Management] Always define your stop-loss before entering a trade, not after. Pre-defining your exit removes emotion from the decision. A stop at the invalidation point (the level that disproves your thesis) is the most logical placement. ⚠️ Not financial advice.",
          "🛡️ [Risk Management] Risk/Reward ratio: only take trades where your target profit is at least 2× your maximum loss (R:R ≥ 2:1). At this ratio, you need less than a 34% win rate to break even — giving your strategy a wide margin for error. ⚠️ Not financial advice.",
          "🛡️ [Risk Management] Correlation risk: if you hold BTC, ETH, SOL, and AAPL, you effectively have one trade — they're all risk-on assets. True diversification means assets that move independently. Use the chart above to check price correlation between your holdings. ⚠️ Not financial advice.",
        ]}
      />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════
         SECTION 1 — LIVE INTERACTIVE TOOLS (embedded, usable on this page)
         ═══════════════════════════════════════════════════════════════════ -->
    <section class="live-section">
      <h2 class="section-heading">
        <span class="section-dot"></span> Live Tools — Use Right Here
      </h2>
      <p class="section-desc">
        These tools are embedded directly on this page — no install, no sign-up required.
      </p>

      <!-- ── Tool 1: TradingView Advanced Chart ─────────────────────────── -->
      <div class="live-tool-card">
        <div class="live-tool-header">
          <span class="live-emoji">📈</span>
          <div>
            <h3 class="live-tool-title">Live Market Chart</h3>
            <p class="live-tool-desc">
              Real-time interactive chart for any stock, crypto, forex, or index.
              Switch symbols, timeframes, drawing tools, indicators — fully featured TradingView chart embedded here.
            </p>
          </div>
          <span class="live-badge">LIVE</span>
        </div>

        <!-- Symbol selector -->
        <div class="symbol-row">
          <span class="symbol-label">Quick switch:</span>
          {[
            { sym: "BINANCE:BTCUSDT",  label: "BTC/USDT" },
            { sym: "BINANCE:ETHUSDT",  label: "ETH/USDT" },
            { sym: "NASDAQ:AAPL",      label: "AAPL" },
            { sym: "NASDAQ:NVDA",      label: "NVDA" },
            { sym: "FOREXCOM:SPXUSD",  label: "S&P 500" },
          ].map((s) => (
            <button class="sym-btn" data-sym={s.sym} type="button">{s.label}</button>
          ))}
        </div>

        <!-- TradingView Advanced Chart container -->
        <div class="tv-chart-wrap">
          <div id="tv-advanced-chart"></div>
        </div>
      </div>

      <!-- ── Tool 2: TradingView Crypto Screener ────────────────────────── -->
      <div class="live-tool-card" style="margin-top:1.5rem;">
        <div class="live-tool-header">
          <span class="live-emoji">🔍</span>
          <div>
            <h3 class="live-tool-title">Crypto Market Screener</h3>
            <p class="live-tool-desc">
              Scan the entire crypto market by price change, volume, market cap, RSI, and more — live data, updated every few seconds.
            </p>
          </div>
          <span class="live-badge">LIVE</span>
        </div>
        <div class="tv-chart-wrap tv-chart-wrap--screener">
          <div class="tradingview-widget-container__widget" id="tv-screener"></div>
        </div>
      </div>

    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         SECTION 2 — OPEN SOURCE GITHUB TOOLS (self-host / developer resources)
         ═══════════════════════════════════════════════════════════════════ -->
    <section class="github-section">
      <h2 class="section-heading">
        <span class="section-dot section-dot--purple"></span> Open-Source Developer Resources
      </h2>
      <p class="section-desc">
        These are GitHub projects you can clone, run locally, or deploy on your own server.
        They are powerful swarm-AI and quant-finance libraries — not browser embeds, but freely available to build with.
      </p>

      <!-- ── Category Filter Tabs ────────────────────────────────────────── -->
      <nav class="filter-nav" id="filter-nav" aria-label="Tool categories">
        {CATEGORIES.map((cat) => (
          <button
            class={`filter-btn ${cat.key === "all" ? "active" : ""}`}
            data-category={cat.key}
            type="button"
          >
            {cat.label}
            <span class="filter-count">{cat.count}</span>
          </button>
        ))}
      </nav>

      <!-- ── Tools Grid ──────────────────────────────────────────────────── -->
      <div class="tools-grid" id="tools-grid">
        {TOOLS.map((tool) => (
          <article class="tool-card" data-category={tool.category}>
            <div class="tool-top">
              <span class="tool-category-tag">{tool.label}</span>
              <span
                class="tool-badge"
                style={`background: ${tool.badgeColor}20; color: ${tool.badgeColor}; border-color: ${tool.badgeColor}50;`}
              >
                {tool.badge}
              </span>
            </div>

            <div class="tool-title-row">
              <span class="tool-emoji" aria-hidden="true">{tool.emoji}</span>
              <h3 class="tool-title">{tool.title}</h3>
            </div>

            <p class="tool-description">{tool.description}</p>

            <div class="tool-tags">
              {tool.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>

            <div class="tool-meta">
              <span class="tool-stars">{tool.stars}</span>
            </div>

            <a
              href={tool.github}
              target="_blank"
              rel="noopener noreferrer"
              class="tool-cta"
              aria-label={`View ${tool.title} on GitHub`}
            >
              VIEW ON GITHUB
              <span class="cta-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>

      <!-- ── No results fallback ────────────────────────────────────────── -->
      <div class="no-results" id="no-results" style="display:none;">
        <span>🔍</span>
        <p>No tools in this category yet.</p>
      </div>
    </section>

    <!-- ── About Swarm Intelligence Banner ──────────────────────────────── -->
    <div class="about-banner panel">
      <h2 class="about-title">🐝 What is Swarm Intelligence for Finance?</h2>
      <p class="about-desc">
        Swarm intelligence applies collective behavior principles — borrowed from ant colonies, bird flocking, and bee swarms —
        to financial analysis. Multiple autonomous AI agents each analyze different facets of a market (fundamentals, sentiment,
        technical indicators, on-chain data) and their combined output produces more accurate predictions than any single model.
        Tools like <strong>MiroFish</strong> and <strong>AutoHedge</strong> bring this approach to open-source finance.
      </p>
      <div class="about-links">
        <a
          href="https://github.com/topics/swarm-intelligence"
          target="_blank"
          rel="noopener noreferrer"
          class="about-btn"
        >
          🔍 Explore GitHub Topic
        </a>
        <a
          href="https://github.com/The-Swarm-Corporation/awesome-financial-agents"
          target="_blank"
          rel="noopener noreferrer"
          class="about-btn"
        >
          📋 Full Agents List
        </a>
      </div>
    </div>

  </div>
</Layout>

<!-- ── TradingView + category filter (non-blocking) ──────────────────────────── -->
<script is:inline>
(function () {
  const DEFAULT_SYM = 'BINANCE:BTCUSDT';
  const FALLBACK_MSG = 'TradingView chart could not be loaded. ' +
    'Please check your network connection or disable ad blockers.';

  /* ── Advanced Chart (requires tv.js — called from onload) ──────────── */
  function buildChart(sym) {
    const el = document.getElementById('tv-advanced-chart');
    if (!el) return;
    el.innerHTML = '';
    if (!window.TradingView || typeof window.TradingView.widget !== 'function') {
      el.textContent = FALLBACK_MSG;
      return;
    }
    try {
      new window.TradingView.widget({
        container_id:        'tv-advanced-chart',
        symbol:              sym || DEFAULT_SYM,
        interval:            '60',
        timezone:            'Etc/UTC',
        theme:               'dark',
        style:               '1',
        locale:              'en',
        width:               '100%',
        height:              520,
        toolbar_bg:          '#0a0f0a',
        enable_publishing:   false,
        allow_symbol_change: true,
        hide_side_toolbar:   false,
        withdateranges:      true,
        save_image:          false,
      });
    } catch (e) {
      console.error('Failed to initialize TradingView widget:', e);
      const el2 = document.getElementById('tv-advanced-chart');
      if (el2) el2.textContent = FALLBACK_MSG;
    }
  }

  /* ── Load tv.js asynchronously; build chart in onload ──────────────── */
  const tvScript = document.createElement('script');
  tvScript.src = 'https://s3.tradingview.com/tv.js';
  tvScript.async = true;
  tvScript.onload = function () { buildChart(DEFAULT_SYM); };
  tvScript.onerror = function () {
    const el = document.getElementById('tv-advanced-chart');
    if (el) el.textContent = FALLBACK_MSG;
  };
  document.head.appendChild(tvScript);

  /* ── Symbol quick-switch buttons (delegate; chart init is async) ───── */
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('.sym-btn');
    if (!btn) return;
    document.querySelectorAll('.sym-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    buildChart(btn.dataset.sym);
  });

  /* ── Crypto Screener (self-loading embed — no tv.js dependency) ─────── */
  (function () {
    const screenerEl = document.getElementById('tv-screener');
    if (!screenerEl) return;
    const s = document.createElement('script');
    s.type = 'text/javascript';
    s.async = true;
    s.src = 'https://s3.tradingview.com/external-embedding/embed-widget-screener.js';
    s.innerHTML = JSON.stringify({
      width: '100%', height: 490,
      defaultColumn: 'overview', defaultScreen: 'general',
      market: 'crypto', showToolbar: true,
      colorTheme: 'dark', locale: 'en',
    });
    screenerEl.appendChild(s);
  })();



  /* ── GitHub tools category filter (no tv.js dependency) ────────────── */
  (function () {
    const grid      = document.getElementById('tools-grid');
    const noResults = document.getElementById('no-results');
    const filterNav = document.getElementById('filter-nav');
    if (!grid || !noResults || !filterNav) return;
    filterNav.addEventListener('click', function (e) {
      const btn = e.target.closest('.filter-btn');
      if (!btn) return;
      const cat = btn.dataset.category;
      filterNav.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      let visible = 0;
      grid.querySelectorAll('.tool-card').forEach(function (card) {
        const matches = cat === 'all' || card.dataset.category === cat;
        card.style.display = matches ? '' : 'none';
        if (matches) visible++;
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
    });
  })();
})();
</script>

