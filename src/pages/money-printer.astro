---
import Layout from "../components/Layout.astro";
import MoneyPrinterIsland from "../components/MoneyPrinter.tsx";

export const prerender = true;

export const title = "Money Printer";
export const navCategory = "mtx-token";
---

<Layout title="MTX Money Printer - Matrix Hub">
  <div class="money-printer-page">
    <h1 class="page-title">MTX MONEY PRINTER 🖨️</h1>
    <p class="page-description">
      Calculate your staking yields, compound earnings, and casino returns.
      Find out how much MTX your stack can generate.
    </p>

    <MoneyPrinterIsland client:load />
  </div>
</Layout>

<style>
  .money-printer-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .page-title {
    font-size: 2.5rem;
    color: var(--theme-primary);
    text-align: center;
    margin-bottom: 1rem;
    text-shadow: 0 0 20px var(--theme-glow);
    font-family: 'Courier New', monospace;
    letter-spacing: 3px;
    animation: glow-pulse 2s ease-in-out infinite alternate;
  }

  @keyframes glow-pulse {
    from { text-shadow: 0 0 10px var(--theme-glow), 0 0 20px var(--theme-glow); }
    to   { text-shadow: 0 0 20px var(--theme-glow), 0 0 40px var(--theme-glow), 0 0 60px var(--theme-glow); }
  }

  .page-description {
    text-align: center;
    font-size: 1.05rem;
    color: var(--theme-text);
    margin-bottom: 2.5rem;
    opacity: 0.85;
    font-family: 'Courier New', monospace;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 1.8rem;
      letter-spacing: 1px;
    }

    .money-printer-page {
      padding: 1rem 0.5rem;
    }
  }
</style>
