---
import Layout from '../components/Layout.astro';
import { readFile, access } from 'fs/promises';
import { join } from 'path';

export const prerender = true;
export const title = "Content Feed";
export const navCategory = "resources";

interface FeedItem {
  title: string;
  path: string;
  modified: string;
  description: string;
  category: string;
  wordCount: number;
  tags: string[];
}

interface FeedData {
  generated: string;
  totalFiles: number;
  categories: Record<string, number>;
  recentUpdates: Array<Pick<FeedItem, 'title' | 'path' | 'modified'>>;
  content: FeedItem[];
}

// This page demonstrates the content workflow by displaying the public feed
const feedPath = '/public-feed.json';

// Check if feed exists, otherwise show placeholder
let feedData: FeedData | null = null;
let feedError: string | null = null;

try {
  // Try to load the feed at build time
  const feedFile = join(process.cwd(), 'public', 'public-feed.json');
  
  // Check if file exists using async access
  await access(feedFile);
  const content = await readFile(feedFile, 'utf-8');
  feedData = JSON.parse(content) as FeedData;
} catch (error) {
  feedError = 'Feed not yet generated. Run `npm run content:generate` to create it.';
}
---

<Layout title="Content Feed - Matrix Hub">
  <main class="min-h-screen bg-gradient-to-b from-gray-900 to-black text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">
          Content Feed
        </h1>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Real-time content discovery powered by the Matrix-Hub Content Workflow
        </p>
        <div class="mt-4 flex justify-center gap-4">
          <a 
            href={feedPath}
            target="_blank"
            class="px-6 py-2 bg-cyan-600 hover:bg-cyan-700 rounded-lg transition-colors"
          >
            📄 View Raw JSON
          </a>
          <a 
            href="https://github.com/bran8912-ctrl/Matrix-Hub.org/blob/main/CONTENT_WORKFLOW.md"
            target="_blank"
            class="px-6 py-2 bg-gray-700 hover:bg-gray-600 rounded-lg transition-colors"
          >
            📚 Documentation
          </a>
        </div>
      </div>

      {feedError ? (
        <div>
          <!-- Error State -->
          <div class="bg-yellow-900/20 border border-yellow-600 rounded-lg p-8 text-center">
            <div class="text-6xl mb-4">⚠️</div>
            <h2 class="text-2xl font-semibold mb-2 text-yellow-400">Feed Not Available</h2>
            <p class="text-gray-300 mb-4">{feedError}</p>
            <div class="bg-gray-800 rounded p-4 text-left font-mono text-sm">
              <div class="text-cyan-400"># Generate the content feed:</div>
              <div class="text-white">npm run content:generate</div>
            </div>
          </div>
        </div>
      ) : feedData ? (
        <div>
          <!-- Feed Content -->
          <div class="space-y-8">
            <!-- Stats Overview -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-gradient-to-br from-cyan-900/30 to-cyan-800/20 border border-cyan-700 rounded-lg p-6">
              <div class="text-cyan-400 text-sm font-semibold uppercase mb-2">Total Content</div>
              <div class="text-4xl font-bold">{feedData.totalFiles}</div>
              <div class="text-gray-400 text-sm mt-1">Files indexed</div>
            </div>
            
            <div class="bg-gradient-to-br from-blue-900/30 to-blue-800/20 border border-blue-700 rounded-lg p-6">
              <div class="text-blue-400 text-sm font-semibold uppercase mb-2">Categories</div>
              <div class="text-4xl font-bold">{Object.keys(feedData.categories).length}</div>
              <div class="text-gray-400 text-sm mt-1">Content types</div>
            </div>
            
            <div class="bg-gradient-to-br from-purple-900/30 to-purple-800/20 border border-purple-700 rounded-lg p-6">
              <div class="text-purple-400 text-sm font-semibold uppercase mb-2">Last Updated</div>
              <div class="text-lg font-bold">
                {new Date(feedData.generated).toLocaleDateString()}
              </div>
              <div class="text-gray-400 text-sm mt-1">
                {new Date(feedData.generated).toLocaleTimeString()}
              </div>
            </div>
          </div>

          <!-- Categories Breakdown -->
          <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
            <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
              <span>📊</span> Content by Category
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              {Object.entries(feedData.categories).map(([category, count]) => (
                <div class="bg-gray-900/50 border border-gray-600 rounded-lg p-4">
                  <div class="text-gray-400 text-sm capitalize">{category}</div>
                  <div class="text-2xl font-bold text-cyan-400">{count}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- Recent Updates -->
          <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
            <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
              <span>🔄</span> Recent Updates
            </h2>
            <div class="space-y-3">
              {feedData.recentUpdates.map((item) => (
                <div class="bg-gray-900/50 border border-gray-600 rounded-lg p-4 hover:border-cyan-500 transition-colors">
                  <div class="flex justify-between items-start">
                    <div class="flex-1">
                      <h3 class="text-lg font-semibold text-cyan-400">{item.title}</h3>
                      <p class="text-gray-400 text-sm mt-1">{item.path}</p>
                    </div>
                    <div class="text-right text-sm text-gray-400">
                      {new Date(item.modified).toLocaleDateString()}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- All Content -->
          <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
            <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
              <span>📚</span> All Content
            </h2>
            <div class="space-y-2 max-h-96 overflow-y-auto">
              {feedData.content.map((item) => (
                <div class="bg-gray-900/50 border border-gray-600 rounded-lg p-4 hover:border-cyan-500 transition-colors">
                  <div class="flex justify-between items-start gap-4">
                    <div class="flex-1">
                      <h3 class="font-semibold text-white">{item.title}</h3>
                      {item.description && (
                        <p class="text-gray-400 text-sm mt-1">{item.description}</p>
                      )}
                      <div class="flex items-center gap-3 mt-2 text-sm">
                        <span class="text-cyan-400 capitalize">
                          {item.category}
                        </span>
                        {item.wordCount > 0 && (
                          <span class="text-gray-500">
                            {item.wordCount.toLocaleString()} words
                          </span>
                        )}
                        {item.tags && item.tags.length > 0 && (
                          <span class="text-gray-500">
                            🏷️ {item.tags.slice(0, 3).join(', ')}
                          </span>
                        )}
                      </div>
                    </div>
                    <div class="text-right text-xs text-gray-500">
                      {new Date(item.modified).toLocaleDateString()}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- API Usage Info -->
          <div class="bg-gradient-to-r from-cyan-900/20 to-blue-900/20 border border-cyan-700 rounded-lg p-6">
            <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
              <span>🔌</span> API Usage
            </h2>
            <p class="text-gray-300 mb-4">
              This feed is available as a public JSON API endpoint. You can use it in your applications, scripts, or integrations.
            </p>
            <div class="bg-gray-900 rounded-lg p-4 font-mono text-sm overflow-x-auto">
              <div class="text-cyan-400"># Fetch the feed</div>
              <div class="text-white">curl https://matrix-hub.org/public-feed.json</div>
              <div class="mt-3 text-cyan-400"># Use in JavaScript</div>
              <div class="text-white">const feed = await fetch('/public-feed.json').then(r ={'>'} r.json());</div>
              <div class="mt-3 text-cyan-400"># Access in Python</div>
              <div class="text-white">import requests</div>
              <div class="text-white">feed = requests.get('https://matrix-hub.org/public-feed.json').json()</div>
            </div>
          </div>

          <!-- Workflow Info -->
          <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
            <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
              <span>⚙️</span> About the Content Workflow
            </h2>
            <p class="text-gray-300 mb-4">
              This feed is automatically generated by the Matrix-Hub Content Workflow Script, a powerful tool for content management, analytics, and SEO optimization.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <h3 class="font-semibold text-cyan-400">Features</h3>
                <ul class="space-y-1 text-sm text-gray-300">
                  <li>✓ Fast content discovery with fast-glob</li>
                  <li>✓ Frontmatter parsing with gray-matter</li>
                  <li>✓ Live file watching with chokidar</li>
                  <li>✓ Comprehensive error logging</li>
                  <li>✓ Content analytics and reporting</li>
                  <li>✓ Public API feed generation</li>
                </ul>
              </div>
              <div class="space-y-2">
                <h3 class="font-semibold text-cyan-400">Commands</h3>
                <ul class="space-y-1 text-sm text-gray-300 font-mono">
                  <li>npm run content:scan</li>
                  <li>npm run content:generate</li>
                  <li>npm run content:analytics</li>
                  <li>npm run content:watch</li>
                </ul>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-700">
              <a 
                href="https://github.com/bran8912-ctrl/Matrix-Hub.org/blob/main/CONTENT_WORKFLOW.md"
                target="_blank"
                class="text-cyan-400 hover:text-cyan-300 underline"
              >
                Read the full documentation →
              </a>
            </div>
            </div>
          </div>
        </div>
      ) : (
        <div>
          <!-- Loading State -->
          <div class="text-center py-12">
            <div class="text-6xl mb-4">⏳</div>
            <p class="text-gray-400">Loading feed data...</p>
          </div>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  /* Custom scrollbar for content list */
  .overflow-y-auto::-webkit-scrollbar {
    width: 8px;
  }
  
  .overflow-y-auto::-webkit-scrollbar-track {
    background: #1f2937;
    border-radius: 4px;
  }
  
  .overflow-y-auto::-webkit-scrollbar-thumb {
    background: #4b5563;
    border-radius: 4px;
  }
  
  .overflow-y-auto::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
  }
</style>
