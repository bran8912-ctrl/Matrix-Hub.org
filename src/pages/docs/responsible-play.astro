---
import Layout from "../../components/Layout.astro";
import { Content as ResponsiblePlayContent } from "../../../docs/MTX_Casino_Responsible_Play.md";

export const prerender = true;

export const title = "Responsible Play";
export const navCategory = "resources";
---

<Layout title="Responsible Play - Matrix Hub">
  <div class="docs-container">
    <article class="markdown-content">
      <ResponsiblePlayContent />
    </article>
  </div>
</Layout>

<style>
  .docs-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
  }

  .markdown-content {
    color: var(--theme-text);
    line-height: 1.6;
  }

  .markdown-content :global(h1) {
    color: var(--theme-primary);
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    text-shadow: 0 0 10px var(--theme-glow);
  }

  .markdown-content :global(h2) {
    color: var(--theme-primary);
    font-size: 2rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    text-shadow: 0 0 8px var(--theme-glow);
  }

  .markdown-content :global(h3) {
    color: var(--theme-secondary);
    font-size: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .markdown-content :global(p) {
    margin-bottom: 1rem;
  }

  .markdown-content :global(ul) {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }

  .markdown-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .markdown-content :global(a) {
    color: var(--theme-accent);
    text-decoration: underline;
  }

  .markdown-content :global(a:hover) {
    color: var(--theme-primary);
    text-shadow: 0 0 5px var(--theme-glow);
  }

  .markdown-content :global(hr) {
    border: none;
    border-top: 1px solid var(--theme-secondary);
    margin: 2rem 0;
    opacity: 0.3;
  }

  .markdown-content :global(code) {
    background-color: rgba(0, 255, 0, 0.1);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
  }

  @media (max-width: 768px) {
    .docs-container {
      padding: 10px;
    }

    .markdown-content :global(h1) {
      font-size: 2rem;
    }

    .markdown-content :global(h2) {
      font-size: 1.5rem;
    }
  }
</style>
