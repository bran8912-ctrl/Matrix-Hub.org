---
import Layout from "../components/Layout.astro";
import MatrixProfitBot from "../components/MatrixProfitBot.astro";
import MTXEcosystem from "../components/MTXEcosystem.astro";
import CasinoGamesPanel from "../components/CasinoGamesPanel.astro";
import MTXOwnershipPanel from "../components/MTXOwnershipPanel.astro";
import DonateBanner from "../components/DonateBanner.astro";
import TelegramWidget from "../components/TelegramWidget.astro";
import MTXStatsWidget from "../components/MTXStatsWidget.tsx";

export const prerender = true;

export const title = "Home";
export const navCategory = "home";
---

<Layout title="The Matrix Hub - Blockchain Tools & Casino">
  <div class="homepage-header">
    <h1 class="matrix-title">THE MATRIX HUB</h1>
    <p class="matrix-subtitle">
      Your gateway to blockchain tools, MTX token ecosystem, and provably fair casino games.
    </p>
  </div>

  <section class="n8n-cta">
    <div class="n8n-cta-card">
      <div class="n8n-cta-badge">AI Automation</div>
      <h2>Bring n8n into your Matrix Hub workflow</h2>
      <p>
        Launch workflows, route requests, and connect your site into a real automation layer using the
        self-hostable n8n runtime.
      </p>
      <a class="n8n-cta-link" href="/projects/n8n">Explore n8n</a>
    </div>
  </section>

  <!-- MTX Stats Widget -->
  <div class="stats-widget-container">
    <MTXStatsWidget client:load />
  </div>

  <!-- MTX Ecosystem Section -->
  <MTXEcosystem />

  <!-- Casino Games Panel -->
  <CasinoGamesPanel />

  <section class="profit-console-section">
    <div class="profit-console-header">
      <span class="profit-console-label">Local Engine</span>
      <h2>💸 Matrix Profit Console</h2>
      <p>Explore monetization ideas and estimate affiliate revenue. Runs entirely in your browser.</p>
    </div>
    <MatrixProfitBot />
  </section>

  <!-- MTX Ownership & Casino Economics -->
  <MTXOwnershipPanel />

  <!-- Donation Banner -->
  <DonateBanner />

  <!-- Telegram Widget -->
  <TelegramWidget />
</Layout>

<style>
  .homepage-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .matrix-title {
    font-size: 2.8rem;
    color: var(--theme-primary);
    text-shadow: 0 0 20px var(--theme-glow);
    font-family: 'Courier New', monospace;
    letter-spacing: 4px;
    margin-bottom: 15px;
    animation: glow-pulse 2s ease-in-out infinite alternate;
  }

  @keyframes glow-pulse {
    from {
      text-shadow: 0 0 10px var(--theme-glow), 0 0 20px var(--theme-glow);
    }
    to {
      text-shadow: 0 0 20px var(--theme-glow), 0 0 40px var(--theme-glow), 0 0 60px var(--theme-glow);
    }
  }

  .matrix-subtitle {
    font-size: 1.2rem;
    color: var(--theme-text);
    text-shadow: 0 0 10px var(--theme-secondary);
    font-family: 'Courier New', monospace;
  }

  .n8n-cta {
    max-width: 760px;
    margin: 0 auto 36px auto;
  }

  .n8n-cta-card {
    display: grid;
    gap: 0.9rem;
    padding: 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: rgba(12, 18, 26, 0.72);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
  }

  .n8n-cta-badge {
    display: inline-flex;
    width: fit-content;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--theme-primary, #00ff99);
    color: var(--theme-primary, #00ff99);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .n8n-cta-card h2 {
    margin: 0;
    color: var(--theme-text, #ffffff);
    font-size: 1.45rem;
  }

  .n8n-cta-card p {
    margin: 0;
    color: var(--theme-muted, #b8c1cc);
    line-height: 1.7;
  }

  .n8n-cta-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem;
    text-decoration: none;
    border-radius: 10px;
    border: 1px solid var(--theme-primary, #00ff99);
    color: var(--theme-primary, #00ff99);
    font-weight: 700;
  }

  .stats-widget-container {
    max-width: 400px;
    margin: 0 auto 40px auto;
  }

  .profit-console-section {
    max-width: 860px;
    margin: 0 auto 40px;
    padding: 0 1rem;
  }

  .profit-console-header {
    margin-bottom: 2rem;
    text-align: center;
    font-family: 'Courier New', monospace;
  }

  .profit-console-label {
    display: inline-block;
    margin-bottom: 0.8rem;
    padding: 0.3rem 1rem;
    color: var(--theme-primary, #00ff99);
    border: 1px solid var(--theme-primary, #00ff99);
    border-radius: 2px;
    font-size: 0.7rem;
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .profit-console-header h2 {
    margin: 0 0 0.6rem;
    color: var(--theme-primary, #00ff99);
    font-size: clamp(1.4rem, 4vw, 2rem);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .profit-console-header p {
    color: var(--theme-muted, #b8c1cc);
    font-size: 0.95rem;
    letter-spacing: 1px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .stats-widget-container {
      max-width: 100%;
      padding: 0 1rem;
    }
    
    .matrix-title {
      font-size: 2rem;
      letter-spacing: 2px;
    }

    .matrix-subtitle {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .matrix-title {
      font-size: 1.8rem;
    }

    .matrix-subtitle {
      font-size: 0.9rem;
    }

    .n8n-cta-card {
      padding: 1rem;
    }
  }
</style>
