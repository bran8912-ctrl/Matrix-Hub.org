---
import Layout from "../components/Layout.astro";
import WalletIsland from "../components/Wallet.jsx";

export const prerender = true;

export const title = "Wallet";
export const navCategory = "mtx-token";
---

<Layout title="MTX Wallet - Matrix Hub">
  <div class="wallet-page">
    <h1 class="page-title">MTX Wallet</h1>
    <p class="page-description">
      Connect your wallet to view your MTX balance and interact with the Matrix Hub ecosystem.
    </p>
    
    <!-- Wallet Component - React Island -->
    <div class="wallet-section">
      <WalletIsland client:only="react" />
    </div>

    <div class="info-section">
      <h2>Features</h2>
      <ul>
        <li>Connect your Polygon wallet (MetaMask or compatible)</li>
        <li>View your MTX token balance</li>
        <li>Add MTX to your wallet (EIP-747)</li>
        <li>Buy MTX on QuickSwap DEX</li>
        <li>Buy MTX via Direct Mint (send MATIC to mint MTX)</li>
        <li>Automatic network switching to Polygon</li>
      </ul>
      
      <h2>Usage</h2>
      <p>
        To use the wallet, simply click "Connect Wallet" and follow the prompts in your wallet extension.
        Once connected, you'll be able to see your MTX balance and access purchase options including 
        direct mint and QuickSwap DEX trading.
      </p>
    </div>
  </div>
</Layout>

<style>
  .wallet-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .page-title {
    font-size: 2.5rem;
    color: var(--theme-primary);
    text-align: center;
    margin-bottom: 1rem;
    text-shadow: 0 0 15px var(--theme-glow);
    font-family: 'Courier New', monospace;
  }

  .page-description {
    text-align: center;
    font-size: 1.1rem;
    color: var(--theme-text);
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .wallet-section {
    margin: 2rem 0;
    display: flex;
    justify-content: center;
  }

  .info-section {
    margin-top: 3rem;
    padding: 1.5rem;
    background: rgba(0, 255, 153, 0.05);
    border: 1px solid rgba(0, 255, 153, 0.2);
    border-radius: 8px;
  }

  .info-section h2 {
    color: var(--theme-primary);
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-family: 'Courier New', monospace;
  }

  .info-section ul {
    list-style-type: none;
    padding-left: 0;
  }

  .info-section li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--theme-text);
  }

  .info-section li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--theme-primary);
    font-weight: bold;
  }

  .info-section p {
    color: var(--theme-text);
    line-height: 1.6;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .wallet-page {
      padding: 1rem;
    }

    .page-title {
      font-size: 2rem;
    }

    .page-description {
      font-size: 1rem;
    }
  }
</style>
