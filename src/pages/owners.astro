---
import Layout from "../components/Layout.astro";
import AppKitProvider from "../components/AppKitProvider.tsx";
import MintRatePanel from "../components/MintRatePanel.tsx";
import OwnerApprovals from "../components/OwnerApprovals.tsx";

export const prerender = true;

// Get password from environment variable at build time
// Use a hashed version for better security
// Safe handling to prevent build failures if env var is missing
// 2026-11-12 (owner-ordered): the gate on this page is client-side ONLY —
// it is obscurity, not access control. The portal HTML is rendered into
// the built page hidden with display:none, and an unlock path below
// reveals it in the browser:
//   1. Owner wallet (primary): the visitor's browser wallet must be the
//      MTX contract owner/deployer address, checked in-page via
//      window.ethereum against a hardcoded public address.
//   2. Access code (secondary, optional): SHA-256 check against
//      OWNERS_PASSWORD_HASH when one is configured at build time.
// Nothing sensitive lives behind this gate: the portal is a static
// info/terminal page, and anything with real authority (e.g. the deploy
// console's actions) is separately gated on-chain by wallet signatures.
// There is NO placeholder password fallback.
let OWNERS_PASSWORD_HASH = import.meta.env.OWNERS_PASSWORD_HASH || '';
let passwordConfigured = false;

// Check if password is configured properly
if (!OWNERS_PASSWORD_HASH || OWNERS_PASSWORD_HASH === 'sha256-placeholder' || OWNERS_PASSWORD_HASH.trim() === '') {
  console.warn("⚠️ OWNERS_PASSWORD_HASH not configured. Access-code unlock is disabled; the owner-wallet unlock still works.");
  OWNERS_PASSWORD_HASH = '';
  passwordConfigured = false;
} else {
  passwordConfigured = true;
  console.log("✅ Owners portal password hash loaded successfully");
}

// This page is NOT linked in navigation - accessible only by direct URL
---

<Layout title="Matrix-Hub Owners Portal">
  <div class="owners-portal">
    <div id="password-gate" class="password-gate">
      <div class="password-container">
        <h1 class="portal-title">🔐 MATRIX-HUB OWNERS PORTAL</h1>
        <p class="portal-subtitle">Authorized Access Only</p>
        
        <div class="wallet-section">
          <button type="button" id="wallet-unlock-btn" class="submit-btn wallet-btn">
            Connect MetaMask (owner wallet)
          </button>
          <div id="wallet-message" class="wallet-message"></div>
          <div id="wallet-switch-hint" class="wallet-switch-hint" style="display: none;">Switch accounts in MetaMask and this page will re-check automatically.</div>
        </div>

        {passwordConfigured && (
          <p class="gate-divider">— or use the access code —</p>
        )}

        {!passwordConfigured && (
          <p class="gate-note">
            No access code is configured, so the owner wallet above is the way in.
            An optional code can be enabled by setting the
            <code>OWNERS_PASSWORD_HASH</code> build-time environment variable.
          </p>
        )}
        
        {passwordConfigured && (
          <form id="password-form" class="password-form">
            <label for="password-input">
              Access code
              <input 
                type="password" 
                id="password-input"
                name="password"
                placeholder="Enter access code"
                class="password-input"
                autocomplete="off"
                required
              />
            </label>
            <button type="submit" class="submit-btn">
              ACCESS PORTAL
            </button>
            <div id="error-message" class="error-message"></div>
          </form>
        )}
      </div>
    </div>

    {/* 2026-11-12: portal content is always rendered into the built page,
        hidden with display:none until a gate unlock reveals it (owner
        wallet, or the access code when one is configured). That is
        client-side obscurity, not access control — see the frontmatter
        note. The owner ordered this trade-off: the portal holds nothing
        sensitive, and anything with real authority is gated on-chain. */}
    <div id="portal-content" class="portal-content" style="display: none;">
      <h1 class="welcome-title">🎯 WELCOME TO THE MATRIX-HUB COMMAND CENTER</h1>
      
      <div class="intro-section">
        <p class="intro-text">
          This is your central hub for managing the Matrix-Hub ecosystem. From here, you control 
          content workflows, marketing feeds, analytics, and ecosystem updates.
        </p>
        <p class="highlight-text">
          <strong>🚀 Matrix-Hub</strong> is investor-ready, feature-rich, and built for scale.
        </p>
      </div>

      <!-- MTX Mint Price Section — owner admin control (Nov 12): the
          mint-rate panel from the deploy console, mounted here so the
          rate can be changed from the portal after the wallet unlock.
          The island is inert markup until the gate reveals this div;
          sending still requires the deployer wallet + a manual tap. -->
      <section class="tool-section">
        <h2 class="section-title">💰 MTX Mint Price</h2>
        <AppKitProvider client:only="react">
          <MintRatePanel client:only="react" />
        </AppKitProvider>
      </section>

      <!-- Owner Sign-Off Queue Section — team items that need Brandon's
          wallet signature or explicit go, approved from the portal
          after the wallet unlock (Nov 12). Device-local state only. -->
      <section class="tool-section">
        <h2 class="section-title">✍️ Owner Sign-Off Queue</h2>
        <OwnerApprovals client:only="react" />
      </section>

      <!-- Content Workflow Tools Section -->
      <section class="tool-section">
        <h2 class="section-title">📝 Content Workflow Management</h2>
        
        <div class="tool-card">
          <h3>🔧 Using content-workflow.js</h3>
          <p>The powerful content management script located at the project root handles:</p>
          <ul>
            <li><strong>Content Discovery</strong> - Automatically scans all markdown, MDX, and Astro files</li>
            <li><strong>Public Feed Generation</strong> - Creates <code>public/public-feed.json</code> for marketing/SEO</li>
            <li><strong>Live Updates</strong> - Watch mode auto-regenerates feeds on file changes</li>
            <li><strong>Analytics</strong> - Generates detailed content metrics in <code>public/content-analytics.json</code></li>
            <li><strong>Error Logging</strong> - Comprehensive error tracking in <code>content-workflow-errors.log</code></li>
          </ul>

          <h4>Commands:</h4>
          <div class="command-list">
            <div class="command-item">
              <code>node content-workflow.js scan</code>
              <span class="command-desc">Scan and index all content files</span>
            </div>
            <div class="command-item">
              <code>node content-workflow.js generate</code>
              <span class="command-desc">Generate public JSON feed</span>
            </div>
            <div class="command-item">
              <code>node content-workflow.js watch</code>
              <span class="command-desc">Watch for changes and auto-update</span>
            </div>
            <div class="command-item">
              <code>node content-workflow.js analytics</code>
              <span class="command-desc">Generate content analytics report</span>
            </div>
          </div>
        </div>

        <div class="tool-card">
          <h3>📦 Quick Install Dependencies</h3>
          <p>All required dependencies are already configured:</p>
          <ul>
            <li><code>fast-glob</code> - Fast file pattern matching</li>
            <li><code>gray-matter</code> - Frontmatter parsing</li>
            <li><code>chokidar</code> - File system watcher</li>
          </ul>
          <p class="install-note">
            Dependencies are installed automatically with <code>npm install</code>
          </p>
        </div>
      </section>

      <!-- Marketing & Updates Section -->
      <section class="tool-section">
        <h2 class="section-title">📊 Marketing & Update Tools</h2>
        
        <div class="tool-card">
          <h3>🌐 Public Feed (public-feed.json)</h3>
          <p>This JSON feed is perfect for:</p>
          <ul>
            <li><strong>Marketing Teams</strong> - Real-time content inventory for campaigns</li>
            <li><strong>SEO Tools</strong> - Structured data for search engine optimization</li>
            <li><strong>External APIs</strong> - Machine-readable content catalog</li>
            <li><strong>Analytics Platforms</strong> - Content performance tracking</li>
          </ul>
          <p class="feed-info">
            Location: <code>/public/public-feed.json</code><br>
            Access: <code>https://matrix-hub.org/public-feed.json</code>
          </p>
        </div>

        <div class="tool-card">
          <h3>📈 Content Analytics (content-analytics.json)</h3>
          <p>Comprehensive metrics including:</p>
          <ul>
            <li>Total files, words, and content size</li>
            <li>Category breakdowns and averages</li>
            <li>Tag cloud analysis</li>
            <li>Content health scores (missing titles, descriptions, tags)</li>
          </ul>
          <p class="feed-info">
            Location: <code>/public/content-analytics.json</code><br>
            Use for investor presentations and ecosystem reporting
          </p>
        </div>
      </section>

      <!-- Ecosystem Management Section -->
      <section class="tool-section">
        <h2 class="section-title">🎮 Matrix-Hub Ecosystem Management</h2>
        
        <div class="tool-card">
          <h3>💎 What Makes Matrix-Hub Powerful</h3>
          <ul>
            <li><strong>MTX Token Economy</strong> - Utility token with real use cases in casino and tools</li>
            <li><strong>Provably Fair Casino</strong> - On-chain gaming with Slots, Blackjack, Roulette</li>
            <li><strong>Modular Architecture</strong> - Expandable tools and features ecosystem</li>
            <li><strong>Web3 Integration</strong> - Wallet connectivity and blockchain interactions</li>
            <li><strong>Community-Driven</strong> - GitHub-to-MTX rewards for contributors</li>
            <li><strong>Professional Build</strong> - Astro 5 + React 19 + TypeScript + TailwindCSS</li>
          </ul>
        </div>

        <div class="tool-card">
          <h3>📢 Messaging for Investors & Marketing</h3>
          <p><strong>Elevator Pitch:</strong></p>
          <blockquote class="pitch">
            Matrix-Hub is a live blockchain-powered platform combining web tools, 
            casino games, and a token economy. Built on Polygon with MTX token, 
            featuring provably fair gaming, expandable tooling modules, and a 
            community-driven GitHub-to-MTX reward system. Investor-ready with 
            smart contracts, documentation, and professional architecture.
          </blockquote>

          <p><strong>Key Stats to Highlight:</strong></p>
          <ul>
            <li>✓ Production-ready smart contracts on Polygon</li>
            <li>✓ 3 casino games with on-chain transactions</li>
            <li>✓ Comprehensive tokenomics and DAO governance</li>
            <li>✓ Modern tech stack (Astro 5, React 19, TypeScript)</li>
            <li>✓ Active community and contribution system</li>
            <li>✓ Fully documented codebase and APIs</li>
          </ul>
        </div>

        <div class="tool-card">
          <h3>🚀 Quick Action Checklist</h3>
          <ol>
            <li><strong>Run Analytics:</strong> <code>node content-workflow.js analytics</code></li>
            <li><strong>Generate Feed:</strong> <code>node content-workflow.js generate</code></li>
            <li><strong>Start Watch Mode:</strong> <code>node content-workflow.js watch</code> (for live updates)</li>
            <li><strong>Review Metrics:</strong> Check <code>public/content-analytics.json</code></li>
            <li><strong>Update Marketing:</strong> Use <code>public/public-feed.json</code> for campaigns</li>
            <li><strong>Monitor Errors:</strong> Check <code>content-workflow-errors.log</code></li>
          </ol>
        </div>
      </section>

      <!-- Documentation Section -->
      <section class="tool-section">
        <h2 class="section-title">📚 Full Documentation</h2>
        <div class="tool-card">
          <p>
            For complete setup, usage, and management instructions, see:<br>
            <strong><code>MATRIX-HUB-TOOLS.md</code></strong> in the project root
          </p>
          <p>
            Additional docs available in <code>/docs</code> directory:
          </p>
          <ul>
            <li><code>MTX_Tokenomics.md</code> - Token economy details</li>
            <li><code>MTX_Casino_Architecture.md</code> - Casino system design</li>
            <li><code>MTX_Whitepaper.md</code> - Complete project whitepaper</li>
            <li><code>MTX_DAO_Governance.md</code> - Governance structure</li>
          </ul>
        </div>
      </section>

      <!-- Interactive Terminal Section -->
      <section class="tool-section">
        <h2 class="section-title">💻 Interactive Terminal</h2>
        
        <div class="tool-card terminal-card">
          <h3>🖥️ Command Executor</h3>
          <p>Run content workflow commands directly from the browser:</p>
          
          <div class="terminal">
            <div class="terminal-header">
              <span class="terminal-title">Matrix-Hub Terminal</span>
              <button id="clear-terminal" class="terminal-btn">Clear</button>
            </div>
            <div id="terminal-output" class="terminal-output">
              <div class="terminal-line">Welcome to Matrix-Hub Owners Portal Terminal</div>
              <div class="terminal-line">Available commands: content:scan, content:generate, content:analytics, content:help</div>
              <div class="terminal-line">Type a command and press Enter to execute</div>
              <div class="terminal-line">&nbsp;</div>
            </div>
            <div class="terminal-input-line">
              <span class="terminal-prompt">$</span>
              <input 
                type="text" 
                id="terminal-input" 
                class="terminal-input"
                placeholder="Enter command (e.g., content:generate)"
                autocomplete="off"
              />
            </div>
          </div>

          <div class="terminal-note">
            <p><strong>Note:</strong> This terminal simulates command execution. In production, commands would run server-side.</p>
            <p>Available commands:</p>
            <ul>
              <li><code>content:scan</code> - Scan and index content files</li>
              <li><code>content:generate</code> - Generate public JSON feed</li>
              <li><code>content:analytics</code> - Generate analytics report</li>
              <li><code>content:help</code> - Show help information</li>
            </ul>
          </div>
        </div>
      </section>

      <div class="footer-note">
        <p>🔐 This page is accessible only via direct URL - not linked in site navigation</p>
        <p>🌟 Matrix-Hub: Signal Over Noise</p>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ OWNERS_PASSWORD_HASH, passwordConfigured }}>
  // Client-side gate — obscurity, not access control. The portal HTML
  // ships in this page hidden with display:none; this script reveals it
  // after one of the unlock paths succeeds:
  //   1. Owner wallet: the connected browser wallet must be the MTX
  //      contract owner/deployer address (checked in-page).
  //   2. Access code: SHA-256 check, only when a hash was configured
  //      at build time (OWNERS_PASSWORD_HASH).
  // Anything with real authority (deploy console actions etc.) is
  // gated separately on-chain by wallet signatures.
  const passwordGate = document.getElementById('password-gate');
  const portalContent = document.getElementById('portal-content');
  const passwordForm = document.getElementById('password-form');
  const passwordInput = document.getElementById('password-input');
  const errorMessage = document.getElementById('error-message');
  const walletButton = document.getElementById('wallet-unlock-btn');
  const walletMessage = document.getElementById('wallet-message');
  const switchHint = document.getElementById('wallet-switch-hint');

  // MTX contract owner / deployer wallet. This address is public
  // on-chain and already appears in the site's contract config.
  const OWNER_WALLET = '0x9fb4bb44d8d962d695fc93b3dc15f1b287391077';

  function showPortal() {
    if (passwordGate) passwordGate.style.display = 'none';
    if (portalContent) portalContent.style.display = 'block';
  }

  function hidePortal() {
    if (portalContent) portalContent.style.display = 'none';
    if (passwordGate) passwordGate.style.display = '';
  }

  // Every wallet-gate message goes through here so the "switch accounts"
  // hint stays in step: it shows only under the not-the-owner-wallet
  // message, and hides again for any other message (or none).
  function setWalletMessage(text) {
    if (walletMessage) walletMessage.textContent = text;
    if (switchHint) {
      switchHint.style.display =
        text === "That wallet isn't the owner wallet." ? 'block' : 'none';
    }
  }

  function isOwnerWallet(address) {
    return typeof address === 'string' && address.toLowerCase() === OWNER_WALLET;
  }

  // --- Unlock path 1: owner wallet ---

  function unlockWithWallet() {
    sessionStorage.setItem('owners_wallet_auth', 'owner-wallet');
    showPortal();
  }

  // Already unlocked with the wallet earlier in this tab session
  if (sessionStorage.getItem('owners_wallet_auth') === 'owner-wallet') {
    showPortal();
  }

  // Silent check on load (eth_accounts never pops up): if the browser
  // wallet is already connected and it is the owner wallet, open up.
  if (window.ethereum) {
    window.ethereum
      .request({ method: 'eth_accounts' })
      .then((accounts) => {
        if (accounts && accounts.length > 0 && isOwnerWallet(accounts[0])) {
          unlockWithWallet();
        }
      })
      .catch(() => {
        // Silent check only — a failure here just means no auto-unlock.
      });
  }

  walletButton?.addEventListener('click', async () => {
    if (!window.ethereum) {
      setWalletMessage("No browser wallet found — open this page in MetaMask's browser or connect a wallet first.");
      return;
    }
    try {
      const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
      const account = accounts && accounts.length > 0 ? accounts[0] : '';
      if (isOwnerWallet(account)) {
        setWalletMessage('');
        unlockWithWallet();
      } else {
        setWalletMessage("That wallet isn't the owner wallet.");
      }
    } catch (walletError) {
      setWalletMessage('Wallet connection was cancelled.');
    }
  });

  // Re-check automatically when the account changes inside the wallet
  // while this page is open (or the wallet disconnects): landing on the
  // owner wallet unlocks; moving AWAY from it re-locks, so the portal
  // never stays open for a different account. An access-code unlock is
  // independent of the wallet and is left alone.
  if (window.ethereum && typeof window.ethereum.on === 'function') {
    window.ethereum.on('accountsChanged', (accounts) => {
      const account = accounts && accounts.length > 0 ? accounts[0] : '';
      if (isOwnerWallet(account)) {
        setWalletMessage('');
        unlockWithWallet();
        return;
      }
      if (sessionStorage.getItem('owners_wallet_auth') !== 'owner-wallet') {
        // This tab was not unlocked by the wallet — nothing to re-lock.
        return;
      }
      sessionStorage.removeItem('owners_wallet_auth');
      if (sessionStorage.getItem('owners_auth') !== 'authenticated') {
        hidePortal();
      }
      if (account) {
        setWalletMessage("That wallet isn't the owner wallet.");
      } else {
        setWalletMessage('Wallet disconnected.');
      }
    });
  }

  // --- Unlock path 2: access code (only when a hash is configured) ---
  if (passwordConfigured) {
    // Check if already authenticated
    const isAuthenticated = sessionStorage.getItem('owners_auth') === 'authenticated';
    
    if (isAuthenticated) {
      showPortal();
    }

    // Simple SHA-256 hash function
    async function sha256(message) {
      try {
        const msgBuffer = new TextEncoder().encode(message);
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        return 'sha256-' + hashHex;
      } catch (error) {
        console.error('Hashing error:', error);
        throw error;
      }
    }

    passwordForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = passwordInput?.value;
      
      try {
        const hash = await sha256(password);
        
        if (hash === OWNERS_PASSWORD_HASH) {
          sessionStorage.setItem('owners_auth', 'authenticated');
          if (errorMessage) errorMessage.textContent = '';
          showPortal();
        } else {
          if (errorMessage) errorMessage.textContent = '❌ Invalid access code';
          if (passwordInput) passwordInput.value = '';
        }
      } catch (error) {
        const errorName = error && typeof error === 'object' && 'name' in error
          ? error.name
          : typeof error;

        // Log a more detailed error for debugging
        console.error('Auth error:', errorName, error);

        // Provide a slightly more specific user-facing message
        if (error instanceof Error && /crypto|subtle/i.test(error.message || '')) {
          if (errorMessage) errorMessage.textContent = '❌ Authentication error: secure crypto functions are not available in this browser.';
        } else {
          if (errorMessage) errorMessage.textContent = '❌ Authentication error: unable to process access code. Please try again.';
        }
      }
    });
  }

  // Terminal functionality
  const terminalInput = document.getElementById('terminal-input');
  const terminalOutput = document.getElementById('terminal-output');
  const clearTerminalBtn = document.getElementById('clear-terminal');

  const commands = {
    'content:scan': {
      description: 'Scanning content files...',
      output: [
        '🔍 Scanning content files...',
        '✅ Found 68 content files',
        '✅ Scan complete: 68 files processed',
        '',
        'Files by category:',
        '  - Documentation: 9 files',
        '  - Pages: 17 files',
        '  - Content: 2 files',
        '  - Other: 40 files'
      ]
    },
    'content:generate': {
      description: 'Generating public feed...',
      output: [
        '🔍 Scanning content files...',
        '✅ Found 68 content files',
        '📝 Generating public feed...',
        '✅ Public feed generated: public/public-feed.json',
        '',
        '✅ Feed generation complete'
      ]
    },
    'content:analytics': {
      description: 'Generating analytics...',
      output: [
        '🔍 Scanning content files...',
        '✅ Found 68 content files',
        '📊 Generating analytics...',
        '✅ Analytics generated: public/content-analytics.json',
        '',
        '📊 Summary:',
        '   Total Files: 68',
        '   Total Words: 29,486',
        '   Avg Words/File: 434',
        '   Total Size: 255.89 KB',
        '',
        '✅ Analytics generation complete'
      ]
    },
    'content:help': {
      description: 'Showing help...',
      output: [
        'Matrix-Hub Content Workflow Commands',
        '====================================',
        '',
        'Available commands:',
        '  content:scan       - Scan and index all content files',
        '  content:generate   - Generate public JSON feeds',
        '  content:analytics  - Generate analytics report',
        '  content:help       - Show this help message',
        '',
        'Usage: npm run <command>',
        '',
        'For more information, see CONTENT_WORKFLOW.md'
      ]
    },
    'help': {
      description: 'Showing available commands...',
      output: [
        'Available commands:',
        '  content:scan',
        '  content:generate',
        '  content:analytics',
        '  content:help',
        '',
        'Type a command and press Enter to execute'
      ]
    }
  };

  function addTerminalLine(text, type = 'output') {
    const line = document.createElement('div');
    line.className = `terminal-line terminal-${type}`;
    line.textContent = text;
    terminalOutput.appendChild(line);
    terminalOutput.scrollTop = terminalOutput.scrollHeight;
  }

  function executeCommand(cmd) {
    const trimmedCmd = cmd.trim();
    
    // Show the command being executed
    addTerminalLine(`$ ${trimmedCmd}`, 'command');
    
    if (!trimmedCmd) {
      return;
    }

    if (commands[trimmedCmd]) {
      const command = commands[trimmedCmd];
      command.output.forEach(line => {
        addTerminalLine(line, 'output');
      });
    } else {
      addTerminalLine(`Command not found: ${trimmedCmd}`, 'error');
      addTerminalLine('Type "help" to see available commands', 'info');
    }
    
    addTerminalLine('', 'output'); // Add blank line
  }

  terminalInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      const command = terminalInput.value;
      executeCommand(command);
      terminalInput.value = '';
    }
  });

  clearTerminalBtn?.addEventListener('click', () => {
    terminalOutput.innerHTML = `
      <div class="terminal-line">Welcome to Matrix-Hub Owners Portal Terminal</div>
      <div class="terminal-line">Available commands: content:scan, content:generate, content:analytics, content:help</div>
      <div class="terminal-line">Type a command and press Enter to execute</div>
      <div class="terminal-line">&nbsp;</div>
    `;
  });
</script>

<style>
  .owners-portal {
    min-height: 70vh;
  }

  /* Password Gate Styles */
  .password-gate {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
  }

  .password-container {
    background: linear-gradient(135deg, rgba(0, 255, 0, 0.1), rgba(0, 100, 0, 0.05));
    border: 2px solid rgba(0, 255, 0, 0.3);
    border-radius: 12px;
    padding: 3rem;
    max-width: 500px;
    width: 100%;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0, 255, 0, 0.2);
  }

  .portal-title {
    font-size: 2rem;
    font-weight: bold;
    color: #00ff00;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
  }

  .portal-subtitle {
    color: #00cc00;
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .password-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .password-input {
