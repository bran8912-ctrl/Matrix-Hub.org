---
import Panel from './Panel.astro';
import { MTX } from '../config/mtx';
import { Casino } from '../config/casino';

// Check if contracts are deployed
const mtxDeployed = MTX.isDeployed;
const casinoDeployed = Casino.isFullyDeployed;
---

<Panel title="MTX COIN CASINO" class="casino-panel">
  <div class="panel-text">
    <strong style="color:var(--theme-primary);">VRF-backed Casino Games with MTX</strong><br>
    <span style="color:var(--theme-secondary);">
    The first on-chain release is a single-round Dice wager using Chainlink VRF and MTX.<br>
    Slots, blackjack, roulette, and other games remain disabled until their outcomes and payouts are settled on-chain.
    </span>
  </div>
  
  <div class="contract-info">
    <strong>Contract Addresses:</strong><br>
    <ul>
      <li><strong>MTX Token (MatrixHubCoin):</strong> <span class="contract-address">{mtxDeployed ? (<a href={MTX.blockExplorerUrl} target="_blank" rel="noopener noreferrer" class="contract-link">{MTX.address}</a>) : "Pending Deployment"}</span></li>
      <li><strong>CasinoCore:</strong> <span class="contract-address">{Casino.contracts.casinoCore.isDeployed ? (<a href={Casino.contracts.casinoCore.blockExplorerUrl} target="_blank" rel="noopener noreferrer" class="contract-link">{Casino.contracts.casinoCore.displayAddress}</a>) : Casino.contracts.casinoCore.displayAddress}</span></li>
      <li><strong>CasinoReserve:</strong> <span class="contract-address">{Casino.contracts.casinoReserve.isDeployed ? (<a href={Casino.contracts.casinoReserve.blockExplorerUrl} target="_blank" rel="noopener noreferrer" class="contract-link">{Casino.contracts.casinoReserve.displayAddress}</a>) : Casino.contracts.casinoReserve.displayAddress}</span></li>
      <li><strong>LiquidityRouter:</strong> <span class="contract-address">{Casino.contracts.liquidityRouter.isDeployed ? (<a href={Casino.contracts.liquidityRouter.blockExplorerUrl} target="_blank" rel="noopener noreferrer" class="contract-link">{Casino.contracts.liquidityRouter.displayAddress}</a>) : Casino.contracts.liquidityRouter.displayAddress}</span></li>
      <li><strong>RNGEngine:</strong> <span class="contract-address">{Casino.contracts.rngEngine.isDeployed ? (<a href={Casino.contracts.rngEngine.blockExplorerUrl} target="_blank" rel="noopener noreferrer" class="contract-link">{Casino.contracts.rngEngine.displayAddress}</a>) : Casino.contracts.rngEngine.displayAddress}</span></li>
    </ul>
    {casinoDeployed ? (
      <p style="margin-top: 10px;"><strong>Status:</strong> <span class="status-live">VRF casino contracts are configured on {Casino.chainName}.</span> Only Dice wagers are supported.</p>
    ) : (
      <p style="margin-top: 10px;"><strong>Status:</strong> Wagers are disabled until the VRF casino contracts are deployed and validated on {Casino.chainName}. No MTX will be transferred.</p>
    )}
  </div>
  
  <div class="games-list">
    <h3 style="color:var(--theme-primary); font-size: 1.13rem; margin-bottom: 10px;">MTX Casino Games</h3>
    <ul>
      <li><strong>Dice Roll:</strong> The first supported game. A Chainlink VRF result determines the roll; winners claim settled MTX payouts.</li>
      <li><strong>Slots, blackjack, roulette, mines, plinko, and crash:</strong> Disabled until their game rules and payouts are implemented on-chain.</li>
      <li><strong>Crash <span style="color:var(--theme-secondary);">(Phase 2)</span>:</strong> Multiplier increases until crash. Cash out before crash. High engagement, volatility limited by reserve, transparent logic.</li>
      <li><strong>PvP Wager Arena <span style="color:var(--theme-secondary);">(Phase 3)</span>:</strong> Player-versus-player MTX wagers. No house edge, MTX utility expansion, community-driven.</li>
    </ul>
  </div>
  
  <div class="how-it-works">
    <strong style="color:var(--theme-primary);">How It Works:</strong><br>
    <ol>
      <li>Connect your wallet and approve MTX for the casino contract.</li>
      <li>Place a single-round Dice bet; Chainlink VRF determines the result asynchronously.</li>
      <li>Claim an on-chain MTX payout after a winning result is settled.</li>
    </ol>
    <p style="margin-top: 10px;"><em style="color:var(--theme-secondary);">A pending VRF wager cannot be cancelled or rerolled.</em></p>
  </div>
  
  <div class="casino-links">
    <h4 style="color:var(--theme-primary); margin-bottom: 10px;">Learn More:</h4>
    <ul>
      <li><a href="/docs/casino-architecture">Casino Architecture</a></li>
      <li><a href="/docs/casino-games">Casino Games</a></li>
      <li><a href="/docs/casino-game-math">Casino Game Math</a></li>
      <li><a href="/docs/provably-fair-system">Provably Fair System</a></li>
      <li><a href="/docs/responsible-play">Responsible Play</a></li>
    </ul>
  </div>
</Panel>

<style>
  .casino-panel {
    --matrix-pulse-color: var(--theme-border);
    margin: 30px auto;
    max-width: 900px;
    border: 2px solid var(--theme-border);
    box-shadow: 0 0 24px var(--theme-glow);
  }
  
  .contract-info {
    margin: 18px 0;
    color: var(--theme-primary);
    font-size: 1.01rem;
    background: rgba(0,0,0,0.08);
    border-radius: 6px;
    padding: 12px;
  }
  
  .contract-info ul {
    margin: 10px 0 0 20px;
    font-size: 1em;
  }
  
  .contract-info li {
    margin: 5px 0;
  }
  
  .contract-address {
    color: var(--theme-secondary);
    font-family: 'Courier New', monospace;
    font-size: 0.95em;
    word-break: break-all;
  }

  .contract-link {
    color: var(--theme-secondary);
    text-decoration: underline;
    word-break: break-all;
    transition: color 0.2s ease;
  }

  .contract-link:hover {
    color: var(--theme-primary);
  }

  .status-live {
    color: var(--theme-primary);
    font-weight: bold;
  }
  
  .games-list {
    margin: 24px 0;
  }
  
  .games-list ul {
    margin-left: 20px;
    font-size: 1.05rem;
    color: var(--theme-text);
  }
  
  .games-list li {
    margin: 8px 0;
  }
  
  .how-it-works {
    margin: 18px 0;
    color: var(--theme-text);
    font-size: 1.08rem;
    background: rgba(0,0,0,0.08);
    border-radius: 6px;
    padding: 12px;
  }
  
  .how-it-works ol {
    margin: 10px 0 0 20px;
  }
  
  .how-it-works li {
    margin: 5px 0;
  }
  
  .casino-links {
    margin-top: 24px;
  }
  
  .casino-links ul {
    margin-left: 20px;
    font-size: 1.05rem;
  }
  
  .casino-links li {
    margin: 8px 0;
  }
  
  .casino-links a {
    color: var(--theme-primary);
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .casino-links a:hover {
    color: var(--theme-secondary);
    text-shadow: 0 0 10px var(--theme-glow);
  }
</style>
