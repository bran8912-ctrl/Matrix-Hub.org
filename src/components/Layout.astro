---
import "../../src/styles/globals.css";
import "../../src/styles/music-reactive.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import TabNav from "./TabNav.astro";
import MatrixRain from "./MatrixRain.astro";
import PersistentThemeCustomizer from "./PersistentThemeCustomizer.tsx";
import PersistentMusicPlayer from "./PersistentMusicPlayer.tsx";
import OracleBot from "./OracleBot.astro";
import AppKitProvider from "./AppKitProvider.tsx";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name='impact-site-verification' value='7c857a2b-e958-419c-9417-238f3c42d3dd' />
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          var savedTheme = localStorage.getItem('matrixHubTheme') || 'gold-elite';
          var presets = ['classic', 'cyber-purple', 'neon-blue', 'blood-red', 'gold-elite', 'toxic-orange', 'arctic-white', 'synthwave'];

          if (savedTheme === 'custom') {
            var primary = localStorage.getItem('matrixHubCustomPrimary') || '#00ff00';
            var secondary = localStorage.getItem('matrixHubCustomSecondary') || '#00ffff';
            if (!/^#[\da-f]{6}$/i.test(primary)) primary = '#00ff00';
            if (!/^#[\da-f]{6}$/i.test(secondary)) secondary = '#00ffff';
            root.style.setProperty('--theme-primary', primary);
            root.style.setProperty('--theme-secondary', secondary);
            root.style.setProperty('--theme-glow', primary);
            root.style.setProperty('--theme-border', primary);
            root.style.setProperty('--theme-text', secondary);
          } else if (presets.indexOf(savedTheme) !== -1) {
            root.classList.add('theme-' + savedTheme);
          }
        } catch (error) {}
      })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CKWFL856MZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args){dataLayer.push(...args);}
      gtag('js', new Date());
      gtag('config', 'G-CKWFL856MZ');
    </script>
    <title>{title}</title>
    <!-- Note: External scripts (Google Analytics, Telegram Widget) are loaded without integrity hashes 
         as they are dynamically updated by their providers. Consider implementing CSP headers for additional security. -->
  </head>
  <body>
    <!-- Global Ticker Tape — live prices fixed to top of every page -->
    <div class="global-ticker-tape">
      <div class="global-ticker-container">
        <div id="global-ticker-inner"></div>
      </div>
    </div>
    <script is:inline>
    (function () {
      var el = document.getElementById('global-ticker-inner');
      if (!el) return;
      var s = document.createElement('script');
      s.type = 'text/javascript';
      s.async = true;
      s.src = 'https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
      s.innerHTML = JSON.stringify({
        symbols: [
          { proName: 'BINANCE:BTCUSDT',  title: 'Bitcoin'   },
          { proName: 'BINANCE:ETHUSDT',  title: 'Ethereum'  },
          { proName: 'BINANCE:SOLUSDT',  title: 'Solana'    },
          { proName: 'BINANCE:BNBUSDT',  title: 'BNB'       },
          { proName: 'BINANCE:ADAUSDT',  title: 'Cardano'   },
          { proName: 'BINANCE:XRPUSDT',  title: 'XRP'       },
          { proName: 'BINANCE:DOGEUSDT', title: 'Dogecoin'  },
          { proName: 'FOREXCOM:SPXUSD',  title: 'S&P 500'   },
          { proName: 'NASDAQ:AAPL',      title: 'Apple'     },
          { proName: 'NASDAQ:NVDA',      title: 'NVIDIA'    },
        ],
        showSymbolLogo: true,
        colorTheme: 'dark',
        isTransparent: true,
        displayMode: 'adaptive',
        locale: 'en',
      });
      el.appendChild(s);
    })();
    </script>
    <MatrixRain />
    <AppKitProvider client:only="react">
      <PersistentThemeCustomizer client:only="react" />
      <PersistentMusicPlayer client:only="react" />
    </AppKitProvider>
    <TabNav />
    <Header />
    <main class="w-full max-w-6xl mx-auto px-4 sm:px-8 py-8">
      <slot />
    </main>
    <Footer />
    
    <!-- Matrix-themed Oracle Bot with Avatar -->
    <OracleBot />
  </body>
</html>
