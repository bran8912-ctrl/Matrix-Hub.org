---
/**
 * "Got an invite code?" box — Phase 1 (HUB task 154).
 * Code-only fallback for friends who received a 6-character code in a
 * chat message rather than a link (design §1). Same capture rules as
 * the link: first inviter wins, self-referral ignored.
 */
export const prerender = true;
---

<div class="mh-ref-code-entry">
  <form id="mh-ref-code-form" class="mh-ref-code-form" novalidate>
    <label for="mh-ref-code-input" class="mh-ref-code-label">Got an invite code?</label>
    <div class="mh-ref-code-row">
      <input
        id="mh-ref-code-input"
        type="text"
        inputmode="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="6"
        placeholder="ABC123"
        class="mh-ref-code-input"
      />
      <button type="submit" class="mh-ref-code-btn">Use code</button>
    </div>
    <p id="mh-ref-code-status" class="mh-ref-code-status" role="status" aria-live="polite"></p>
  </form>

  <!-- Scan-to-join (Card 4 — Freya Lindqvist / Ethan Cole): a friend
       holding a printed or on-screen invite QR can scan it instead of
       typing the code. Any camera failure degrades to the manual box
       above; nothing here replaces it. -->
  <div class="mh-ref-scan-row">
    <button type="button" id="mh-ref-scan-btn" class="mh-ref-code-btn">📷 Scan QR instead</button>
  </div>
  <div id="mh-ref-scan-panel" class="mh-ref-scan-panel" hidden>
    <div id="mh-ref-scan-region" class="mh-ref-scan-region"></div>
    <p id="mh-ref-scan-status" class="mh-ref-code-status" role="status" aria-live="polite"></p>
    <div class="mh-ref-scan-row">
      <button type="button" id="mh-ref-scan-close" class="mh-ref-code-btn">Close scanner</button>
    </div>
  </div>
</div>

<style>
  .mh-ref-code-entry {
    max-width: 520px;
    margin: 1.5rem auto;
    padding: 1rem 1.25rem;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(0, 255, 153, 0.3);
    border-radius: 8px;
    font-family: 'Courier New', monospace;
  }
  .mh-ref-code-label {
    display: block;
    color: var(--theme-primary, #00ff99);
    font-size: 0.95rem;
    letter-spacing: 1px;
    margin-bottom: 0.6rem;
    text-align: center;
  }
  .mh-ref-code-row { display: flex; gap: 0.5rem; }
  .mh-ref-code-input {
    flex: 1;
    min-width: 0;
    padding: 0.55rem 0.75rem;
    background: rgba(0, 0, 0, 0.7);
    color: #a7f3d0;
    border: 1px solid rgba(0, 255, 153, 0.4);
    border-radius: 6px;
    font-family: 'Courier New', monospace;
    font-size: 1rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-align: center;
    outline: none;
  }
  .mh-ref-code-input:focus { border-color: rgba(0, 255, 153, 0.8); }
  .mh-ref-code-btn {
    padding: 0.55rem 1.1rem;
    background: rgba(0, 255, 153, 0.15);
    color: var(--theme-primary, #00ff99);
    border: 1px solid rgba(0, 255, 153, 0.55);
    border-radius: 6px;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    font-weight: bold;
    cursor: pointer;
    white-space: nowrap;
  }
  .mh-ref-code-btn:hover { box-shadow: 0 0 10px rgba(0, 255, 153, 0.3); }
  .mh-ref-code-status {
    margin: 0.6rem 0 0;
    min-height: 1.2em;
    color: #a7f3d0;
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: center;
  }
  .mh-ref-scan-row { display: flex; justify-content: center; margin-top: 0.6rem; }
  .mh-ref-scan-panel { margin-top: 0.75rem; }
  .mh-ref-scan-panel[hidden] { display: none; }
  .mh-ref-scan-region {
    max-width: 320px;
    margin: 0 auto;
    border: 1px solid rgba(0, 255, 153, 0.4);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.7);
  }
  .mh-ref-scan-region video { width: 100% !important; display: block; }
</style>

<script>
  import {
    browserStorage,
    captureInvite,
    extractInviteCodeFromScan,
    normalizeInviteCode,
  } from "../lib/referral";

  (function () {
    const store = browserStorage();
    const form = document.getElementById("mh-ref-code-form") as HTMLFormElement | null;
    const input = document.getElementById("mh-ref-code-input") as HTMLInputElement | null;
    const status = document.getElementById("mh-ref-code-status");
    if (!store || !form || !input || !status) return;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const code = normalizeInviteCode(input.value);
      const result = captureInvite(store, code);
      if (result.status === "saved" || result.status === "already-saved") {
        status.textContent = "Invite code saved. Play a game and you'll both unlock a perk.";
      } else if (result.status === "kept-existing") {
        status.textContent = "An invite code is already saved on this browser, so this one was not added.";
      } else if (result.status === "self") {
        status.textContent = "That is your own invite code — share it with a friend instead.";
      } else {
        status.textContent = "That code does not look right. Invite codes are 6 letters or numbers.";
      }
    });

    /* ── Scan-to-join (Card 4 — Freya Lindqvist / Ethan Cole) ──────
       html5-qrcode is in maintenance mode upstream — accepted in the
       Nov 2026 OSS survey; pinned at 2.3.8. The scanner is isolated
       behind this one dynamic import so swapping libraries later
       touches only this block. Camera denial / no camera / insecure
       context all degrade to the manual box above. */
    const scanBtn = document.getElementById("mh-ref-scan-btn") as HTMLButtonElement | null;
    const scanPanel = document.getElementById("mh-ref-scan-panel");
    const scanStatus = document.getElementById("mh-ref-scan-status");
    const scanClose = document.getElementById("mh-ref-scan-close") as HTMLButtonElement | null;

    let scanner: any = null;
    let scanning = false;
    let lastForeignAt = 0;

    async function stopScanner() {
      if (scanner && scanning) {
        try {
          await scanner.stop();
        } catch {
          /* already stopped */
        }
        try {
          scanner.clear();
        } catch {
          /* nothing rendered */
        }
      }
      scanning = false;
    }

    function submitScannedCode(code: string) {
      input.value = code;
      if (typeof form.requestSubmit === "function") {
        form.requestSubmit();
      } else {
        form.dispatchEvent(new Event("submit", { bubbles: true, cancelable: true }));
      }
    }

    function onDecoded(decodedText: string) {
      const code = extractInviteCodeFromScan(decodedText);
      if (code) {
        void stopScanner();
        if (scanPanel) scanPanel.hidden = true;
        submitScannedCode(code);
        return;
      }
      const now = Date.now();
      if (scanStatus && now - lastForeignAt > 2500) {
        lastForeignAt = now;
        scanStatus.textContent =
          "That QR is not a Matrix Hub invite — keep scanning, or type the code above.";
      }
    }

    async function openScanner() {
      if (!scanPanel || !scanStatus) return;
      scanPanel.hidden = false;
      scanStatus.textContent = "Starting the camera…";
      try {
        const mod = await import("html5-qrcode");
        if (!scanner) scanner = new mod.Html5Qrcode("mh-ref-scan-region");
        await scanner.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: { width: 220, height: 220 } },
          onDecoded,
          () => {
            /* per-frame decode misses are normal — stay silent */
          },
        );
        scanning = true;
        scanStatus.textContent = "Point the camera at a Matrix Hub invite QR.";
      } catch {
        scanning = false;
        scanStatus.textContent =
          "Camera is unavailable or permission was denied — type the 6-letter code in the box above instead.";
      }
    }

    scanBtn?.addEventListener("click", () => {
      if (scanPanel && !scanPanel.hidden) return;
      void openScanner();
    });
    scanClose?.addEventListener("click", () => {
      void stopScanner();
      if (scanPanel) scanPanel.hidden = true;
    });
    window.addEventListener("pagehide", () => {
      void stopScanner();
    });
  })();
</script>
