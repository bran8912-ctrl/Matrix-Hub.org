---
import { MTX } from "../config/mtx";

const currentYear = new Date().getFullYear();
const GITHUB_REPO = "https://github.com/bran8912-ctrl/Matrix-Hub.org";
const POLYGONSCAN_URL = `https://polygonscan.com/token/${MTX.address}`;
// Abbreviated address for display – derived from the same source as the link
const shortAddress = MTX.address.startsWith("0x")
  ? `${MTX.address.slice(0, 6)}...${MTX.address.slice(-4)}`
  : MTX.address;
---

<footer class="site-footer">
  <div class="footer-scan-line"></div>

  <div class="footer-inner">

    <!-- Brand / About column -->
    <div class="footer-col footer-brand">
      <div class="footer-logo">⬡ THE MATRIX HUB</div>
      <p class="footer-tagline">
        Blockchain tools, provably fair casino games, and the MTX token
        ecosystem — all in one decentralized hub.
      </p>
      <div class="footer-badges">
        <span class="badge">⛓ Polygon</span>
        <span class="badge">🔐 Non-Custodial</span>
        <span class="badge">✅ On-Chain</span>
      </div>
    </div>

    <!-- Quick links column -->
    <div class="footer-col">
      <h3 class="footer-heading">Quick Links</h3>
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        <li><a href="/casino">Casino</a></li>
        <li><a href="/wallet">Wallet</a></li>
        <li><a href="/buy-mtx">Buy MTX</a></li>
        <li><a href="/affiliates">Affiliates</a></li>
      </ul>
    </div>

    <!-- Resources column -->
    <div class="footer-col">
      <h3 class="footer-heading">Resources</h3>
      <ul class="footer-links">
        <li><a href="/mtx-contract">MTX Contract</a></li>
        <li><a href="/owners">Ownership</a></li>
        <li><a href="/money-printer">Money Printer</a></li>
        <li><a href="/content-feed">Content Feed</a></li>
        <li>
          <a
            href={GITHUB_REPO}
            target="_blank"
            rel="noopener noreferrer"
          >GitHub</a>
        </li>
        <li>
          <a
            href={POLYGONSCAN_URL}
            target="_blank"
            rel="noopener noreferrer"
          >PolygonScan</a>
        </li>
      </ul>
    </div>

    <!-- Contact column -->
    <div class="footer-col footer-contact">
      <h3 class="footer-heading">Contact Us</h3>
      <ul class="footer-links contact-list">
        <li>
          <a href="mailto:admin@matrix-hub.org" class="contact-item">
            <span class="contact-icon">✉</span>
            <span>admin@matrix-hub.org</span>
          </a>
        </li>
        <li>
          <a
            href="https://t.me/matrixhuborg"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-item"
          >
            <span class="contact-icon">📢</span>
            <span>Telegram Channel</span>
          </a>
        </li>
        <li>
          <a
            href={`${GITHUB_REPO}/issues`}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-item"
          >
            <span class="contact-icon">🐛</span>
            <span>Report a Bug</span>
          </a>
        </li>
        <li>
          <a
            href={`${GITHUB_REPO}/pulls`}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-item"
          >
            <span class="contact-icon">🔧</span>
            <span>Contribute on GitHub</span>
          </a>
        </li>
      </ul>
    </div>

  </div><!-- /.footer-inner -->

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span class="copyright" id="footer-copyright">
        &copy; <span id="footer-year">{currentYear}</span> Matrix-Hub.org — All rights reserved.
      </span>
      <div class="footer-bottom-links">
        <a href="/docs/disclaimer" aria-label="Privacy Policy">Privacy Policy</a>
        <span class="separator" aria-hidden="true">|</span>
        <a href="/docs/responsible-play" aria-label="Terms of Service">Terms of Service</a>
        <span class="separator" aria-hidden="true">|</span>
        <a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer" aria-label="Open Source on GitHub">Open Source</a>
      </div>
      <div class="footer-mtx-note">
        MTX Token: <a
          href={POLYGONSCAN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="address-link"
          title="View MTX token on PolygonScan"
        >{shortAddress}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: 4rem;
    background: rgba(0, 0, 0, 0.85);
    border-top: 2px solid var(--theme-primary, #00ff00);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: 'Courier New', monospace;
    overflow: hidden;
  }

  /* animated scan line at the top of the footer */
  .footer-scan-line {
    position: absolute;
    top: 0;
    left: -100%;
    width: 200%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--theme-primary, #00ff00),
      transparent
    );
    animation: footerScan 4s linear infinite;
    pointer-events: none;
  }

  @keyframes footerScan {
    0%   { left: -100%; }
    100% { left: 100%; }
  }

  /* ── Main grid ────────────────────────────────────────────── */
  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 2.5rem;
    max-width: 1152px;
    margin: 0 auto;
    padding: 3rem 2rem 2rem;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
      padding: 2rem 1rem 1.5rem;
      gap: 1.75rem;
    }
  }

  /* ── Brand column ─────────────────────────────────────────── */
  .footer-logo {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--theme-primary, #00ff00);
    text-shadow: 0 0 14px var(--theme-glow, #00ff00);
    letter-spacing: 3px;
    margin-bottom: 0.75rem;
  }

  .footer-tagline {
    font-size: 0.85rem;
    color: var(--theme-text, #00ffff);
    opacity: 0.8;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge {
    display: inline-block;
    padding: 3px 10px;
    font-size: 0.72rem;
    border: 1px solid var(--theme-primary, #00ff00);
    border-radius: 999px;
    color: var(--theme-primary, #00ff00);
    text-shadow: 0 0 6px var(--theme-glow, #00ff00);
    background: rgba(0, 255, 0, 0.07);
  }

  /* ── Column headings ──────────────────────────────────────── */
  .footer-heading {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--theme-primary, #00ff00);
    text-shadow: 0 0 8px var(--theme-glow, #00ff00);
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(0, 255, 0, 0.25);
  }

  /* ── Link lists ───────────────────────────────────────────── */
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-size: 0.85rem;
    color: var(--theme-text, #00ffff);
    text-decoration: none;
    opacity: 0.85;
    transition: all 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--theme-primary, #00ff00);
    opacity: 1;
    text-shadow: 0 0 8px var(--theme-glow, #00ff00);
    padding-left: 4px;
  }

  /* ── Contact column extras ────────────────────────────────── */
  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  /* ── Bottom bar ───────────────────────────────────────────── */
  .footer-bottom {
    border-top: 1px solid rgba(0, 255, 0, 0.2);
    background: rgba(0, 0, 0, 0.6);
  }

  .footer-bottom-inner {
    max-width: 1152px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--theme-text, #00ffff);
    opacity: 0.7;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .footer-bottom-links a {
    font-size: 0.78rem;
    color: var(--theme-text, #00ffff);
    text-decoration: none;
    opacity: 0.7;
    transition: all 0.2s ease;
  }

  .footer-bottom-links a:hover {
    color: var(--theme-primary, #00ff00);
    opacity: 1;
    text-shadow: 0 0 6px var(--theme-glow, #00ff00);
  }

  .separator {
    color: var(--theme-primary, #00ff00);
    opacity: 0.4;
    font-size: 0.8rem;
  }

  .footer-mtx-note {
    font-size: 0.78rem;
    color: var(--theme-text, #00ffff);
    opacity: 0.6;
  }

  .address-link {
    font-family: 'Courier New', monospace;
    color: var(--theme-secondary, #00ffff);
    text-decoration: none;
    opacity: 1;
  }

  .address-link:hover {
    color: var(--theme-primary, #00ff00);
    text-shadow: 0 0 6px var(--theme-glow, #00ff00);
  }

  @media (max-width: 560px) {
    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem;
      gap: 0.5rem;
    }
  }

  /* Respect users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .footer-scan-line {
      animation: none;
    }
  }
</style>

<script is:inline>
  // Keep the copyright year current client-side (the static build date is the fallback).
  const yearEl = document.getElementById('footer-year');
  if (yearEl) {
    yearEl.textContent = String(new Date().getFullYear());
  }
</script>
