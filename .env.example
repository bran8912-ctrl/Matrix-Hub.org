# Environment variables for Matrix Hub deployment

# ⚠️ GITHUB ACTIONS DEPLOYMENT NOTICE
# For GitHub Actions workflows, configure these as repository secrets:
# - Go to: Repository Settings → Secrets and variables → Actions → Repository secrets
# - For mainnet deployments: Add POLYGON_PRIVATE_KEY, POLYGON_RPC_URL, POLYGONSCAN_API_KEY
# - For testnet deployments: Add TESTNET_PRIVATE_KEY, AMOY_RPC_URL, POLYGONSCAN_API_KEY
# - For application: Add SUPABASE_DATABASE_URL, SUPABASE_ANON_KEY, OWNERS_PASSWORD_HASH
# - See docs/GITHUB_ACTIONS_SECRETS.md for complete guide
#
# For local development:
# - Copy this file to .env: cp .env.example .env
# - Replace placeholder values below with actual values
# - NEVER commit the .env file with real values!

# Private key for deployment (without 0x prefix)
# Local: Use actual private key value here
# GitHub Actions: Configure as POLYGON_PRIVATE_KEY or TESTNET_PRIVATE_KEY secret
#   (workflows automatically map these to PRIVATE_KEY environment variable)
# Get a burner wallet private key for deployment
# ⚠️ NEVER use your main wallet private key!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Polygon RPC URLs
# Local: Use actual RPC URL or leave default
# GitHub Actions: Configure as POLYGON_RPC_URL or AMOY_RPC_URL secret
POLYGON_RPC_URL=https://polygon.drpc.org
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# API Keys for contract verification
# Get from: https://polygonscan.com/myapikey
# Required for verifying contracts after deployment
# Same key works for both Polygon Mainnet and Amoy Testnet
# Local: Add your actual API key
# GitHub Actions: Configure as POLYGONSCAN_API_KEY secret
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Optional MTX Contract Address override
# The selected Polygon token address is configured in src/config/contracts.js.
# Set this only to override that address for a specific deployment environment.
# GitHub Actions: Configure as MTX_CONTRACT_ADDRESS secret only when overriding.
MTX_CONTRACT_ADDRESS=

# Casino deployment configuration (required only when deploying casino contracts)
# Polygon QuickSwap V2 Router02; set the matching router address for other networks.
QUICKSWAP_V2_ROUTER_ADDRESS=0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff
CASINO_MAX_PAYOUT_PER_BET=

# Chainlink VRF v2.5 subscription ID (must be owned by the deployer and funded with official LINK).
# Coordinator and key hash values are pinned for Polygon/Amoy in scripts/deploy_casino.js.
VRF_SUBSCRIPTION_ID=

# Frontend network selection: 137 for Polygon mainnet, 80002 for Amoy testnet.
PUBLIC_CASINO_CHAIN_ID=137

# Set to YES only after Amoy end-to-end testing and independent security review.
POLYGON_CASINO_DEPLOYMENT_APPROVED=

# Supabase (for backend features)
# Get from: https://supabase.com/dashboard
# Local: Add your actual Supabase project credentials
# GitHub Actions: Configure as SUPABASE_DATABASE_URL and SUPABASE_ANON_KEY secrets
SUPABASE_DATABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Live Chat — self-hosted WebSocket server
# Default setup:
# - Run the main server with: node server.mjs (or the corresponding npm script)
# - The LiveChat client connects to same-origin WebSocket endpoints at /chat/<roomId>
# - If /chat is unreachable, the client falls back to localStorage/BroadcastChannel
#
# Optional/legacy chat-server.mjs setup:
# - If you still use chat-server.mjs on a separate port, you MUST reverse-proxy /chat
#   from your main site origin to the chat server, so that /chat/<roomId> remains
#   a same-origin WebSocket endpoint for the client.

# Owners Portal Password Hash
# Generate a SHA-256 hash of your password using the generate-password-hash.js script
# This script is the canonical way to create a valid password hash for Matrix Hub
# The resulting value will already include the required 'sha256-' prefix
# Run: node scripts/generate-password-hash.js "your-secure-password"
# ⚠️ IMPORTANT: Use a strong, unique password!
# Local: Add the generated hash
# GitHub Actions: Configure as OWNERS_PASSWORD_HASH secret
OWNERS_PASSWORD_HASH=sha256-your_password_hash_here

# Casino Contract Addresses (Polygon Mainnet - Chain ID 137)
# Leave unset until each deployment has been validated.
# - CASINO_CORE_ADDRESS
# - CASINO_RESERVE_ADDRESS
# - LIQUIDITY_ROUTER_ADDRESS
# - RNG_ENGINE_ADDRESS
# Prefix with PUBLIC_ for Astro/Vite browser builds.
CASINO_CORE_ADDRESS=
CASINO_RESERVE_ADDRESS=
LIQUIDITY_ROUTER_ADDRESS=
RNG_ENGINE_ADDRESS=
PUBLIC_CASINO_CORE_ADDRESS=
PUBLIC_CASINO_RESERVE_ADDRESS=
PUBLIC_LIQUIDITY_ROUTER_ADDRESS=
PUBLIC_RNG_ENGINE_ADDRESS=
PUBLIC_MTX_CONTRACT_ADDRESS=

# WalletConnect Project ID (for Reown AppKit / Web3Modal v3)
# Get from: https://cloud.reown.com (create a free project)
# Required for wallet connection functionality
# Local: Add your actual project ID
# GitHub Actions: Configure as PUBLIC_WALLETCONNECT_PROJECT_ID secret
PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# n8n webhook endpoint for the server-backed automation proxy
# Optional: set this to a public n8n webhook URL to enable the CTA form on /projects/n8n
# Example: https://your-n8n.example.com/webhook/your-workflow-id
N8N_WEBHOOK_URL=
