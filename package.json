{
  "name": "astro-supabase-starter",
  "type": "module",
  "version": "0.0.1",
  "//": "NOTE: Several deprecated npm packages are used transitively by dependencies:",
  "//deprecated-transitive": {
    "inflight@1.0.6": {
      "description": "Deprecated. Used transitively by glob (versions 5.x, 7.x, 8.x)",
      "parentPackages": [
        "hardhat@2.28.0 -> mocha@10.8.2 -> glob@8.1.0",
        "solhint@6.0.2 -> glob@8.1.0",
        "solidity-coverage@0.8.17 -> globby@10.0.2 -> glob@7.2.3",
        "solidity-coverage@0.8.17 -> sc-istanbul@0.4.6 -> glob@5.0.15",
        "solidity-coverage@0.8.17 -> shelljs@0.8.5 -> glob@7.2.3",
        "typechain@8.3.2 -> glob@7.1.7"
      ],
      "resolution": "Update hardhat, solhint, solidity-coverage, and typechain to versions that use glob@9+ or alternatives"
    },
    "lodash.isequal@4.5.0": {
      "description": "Deprecated. Use require('node:util').isDeepStrictEqual instead",
      "parentPackages": [
        "@nomicfoundation/hardhat-ethers@3.1.3"
      ],
      "resolution": "Update @nomicfoundation/hardhat-ethers to version that removes lodash.isequal dependency"
    },
    "glob (versions 5.x, 7.x, 8.x)": {
      "description": "Glob versions prior to v9 are no longer supported",
      "parentPackages": [
        "hardhat@2.28.0 -> mocha@10.8.2 -> glob@8.1.0",
        "solhint@6.0.2 -> glob@8.1.0",
        "solidity-coverage@0.8.17 -> various -> glob@7.2.3, glob@5.0.15",
        "typechain@8.3.2 -> glob@7.1.7"
      ],
      "resolution": "Update parent packages to versions using glob@9+ or alternatives like fast-glob"
    }
  },
  "//notes": [
    "Run 'npm ls inflight lodash.isequal glob' to see full dependency tree",
    "These transitive dependencies cannot be directly patched without updating parent packages",
    "Consider upgrading hardhat, solhint, solidity-coverage, typechain, and @nomicfoundation/* packages in future maintenance"
  ],
  "scripts": {
    "deploy:testnet:mtx": "hardhat run scripts/deploy_mtx.js --network amoy",
    "deploy:testnet:casino": "hardhat run scripts/deploy_casino.js --network amoy",
    "deploy:testnet:distribute": "hardhat run scripts/distribute_mtx.js --network amoy",
    "deploy:testnet:full": "npm run deploy:testnet:mtx && npm run deploy:testnet:casino && npm run deploy:testnet:distribute",
    "dev": "astro dev",
    "start": "node dist/server/entry.mjs",
    "serve": "npm run build && node dist/server/entry.mjs",
    "build": "astro build",
    "preview": "node dist/server/entry.mjs",
    "astro": "astro",
    "deploy": "./scripts/deploy.sh",
    "compile": "node scripts/compile-wrapper.js",
    "test": "node scripts/test-wrapper.js",
    "deploy:polygon": "hardhat run scripts/deploy_mtx.js --network polygon",
    "deploy:amoy": "hardhat run scripts/deploy_mtx.js --network amoy",
    "verify:polygon": "hardhat verify --network polygon",
    "verify:amoy": "hardhat verify --network amoy",
    "content-workflow": "node content-workflow.js",
    "content:scan": "node content-workflow.js scan",
    "content:generate": "node content-workflow.js generate",
    "content:watch": "node content-workflow.js watch",
    "content:analytics": "node content-workflow.js analytics",
    "content:help": "node content-workflow.js help",
    "chat:server": "node chat-server.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:contracts": "solhint 'contracts/**/*.sol'",
    "typecheck": "astro check",
    "deploy:polygon:casino": "hardhat run scripts/deploy_casino.js --network polygon",
    "deploy:amoy:casino": "hardhat run scripts/deploy_casino.js --network amoy",
    "deploy:polygon:mtx": "hardhat run scripts/deploy_mtx.js --network polygon",
    "deploy:amoy:mtx": "hardhat run scripts/deploy_mtx.js --network amoy",
    "deploy:polygon:full": "npm run deploy:polygon:mtx && npm run deploy:polygon:casino",
    "deploy:amoy:full": "npm run deploy:amoy:mtx && npm run deploy:amoy:casino"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.4.2",
    "@base-org/account": "2.4.0",
    "@ethersproject/sha2": "^5.8.0",
    "@reown/appkit": "^1.8.16",
    "@reown/appkit-adapter-ethers": "^1.8.16",
    "@supabase/supabase-js": "^2.48.0",
    "@tailwindcss/vite": "^4.0.1",
    "@vitejs/plugin-react": "^5.1.2",
    "astro": "^7.3.2",
    "chokidar": "^4.0.0",
    "ethers": "^6.17.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.5",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.4.0",
    "@tailwindcss/typography": "^0.5.16",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^2.3.0",
    "solhint": "^6.0.2",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^4.0.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript-eslint": "^8.51.0"
  }
}
